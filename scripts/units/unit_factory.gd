# ---------------------------------------------------------------- 手搓网格
## 筝形盾的**连续曲面**（2026-09-24：替掉 7 条折线板，消掉"阶梯感"）。
## 轮廓 = 上边齐平且最宽、两侧向下收拢成一点（筝形）；横向沿半径 `KITE_ARC_RADIUS` 的圆弧**前凸**（−Z）。
## 与 `_fan_face_mesh()` 同一套做法：`SurfaceTool` 手搓，正反两面各建一遍 ⇒ 双面可见。
static func _kite_face_mesh() -> ArrayMesh:
	var cols := 8
	var rows := 4
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for face in 2:
		for row in rows:
			for col in cols:
				var u0 := -1.0 + 2.0 * float(col) / float(cols)
				var u1 := -1.0 + 2.0 * float(col + 1) / float(cols)
				var v0 := float(row) / float(rows)
				var v1 := float(row + 1) / float(rows)
				var a := _kite_point(u0, v0)
				var b := _kite_point(u1, v0)
				var c := _kite_point(u1, v1)
				var d := _kite_point(u0, v1)
				if face == 0:
					st.add_vertex(a); st.add_vertex(b); st.add_vertex(c)
					st.add_vertex(a); st.add_vertex(c); st.add_vertex(d)
				else:
					st.add_vertex(a); st.add_vertex(c); st.add_vertex(b)
					st.add_vertex(a); st.add_vertex(d); st.add_vertex(c)
	return st.commit()

## 筝形盾曲面上的一点：`u` ∈ [−1,1] 横向、`v` ∈ [0,1] 由顶边到底尖。
## 宽度按 `1−v` 收成尖；深度沿半径 `KITE_ARC_RADIUS` 的圆弧前凸（正前方是 −Z）。
static func _kite_point(u: float, v: float) -> Vector3:
	const HALF_W := 0.33        ## 顶边半宽（盾宽 ≈ 0.66 m）
	const HEIGHT := 0.95        ## 顶边到底尖的高度（米）
	var x := u * HALF_W * (1.0 - v)
	var bulge := KITE_ARC_RADIUS - sqrt(maxf(KITE_ARC_RADIUS * KITE_ARC_RADIUS - x * x, 0.0))
	return Vector3(x, KITE_TOP - v * HEIGHT, -bulge)

## 通道 ① 体型：躯干粗细与长短。
## 载具：这两台是**机械**，不建人形（躯干 / 头 / 鼻尖 / 头盔全部跳过）。
## 2026-09-24 用户："弩车投石车先把人给去掉"。
const VEHICLE_TYPES := ["catapult", "ballista"]
## **不建人形**的兵种（2026-09-19 起把沙虫并进来）：它们跳过"躯干 / 头 / 鼻尖 / 通道 ② 头盔"，
## 只留自己那一套几何。⚠️ 与 `VEHICLE_TYPES` 的差别：载具还要额外做"整体 ×2 + 抬起"，
## 沙虫不放大（它本来就是一条 2.7 m 长的虫）。
## ⚠️ **2026-09-25 第七轮加进影魔与召唤石柱**，两者各自建自己的 `Body`（都叫 "Body" ⇒ 闪白照旧生效）：
##   · `shadow`：用户要求"**整个人看起来要像一个影子**" ⇒ 躯干必须是墨色（`rest_body_color()`），
##     而骨架那颗胶囊是**队伍色**的 —— 留着它，那个彩色药丸会从影子里透出来；
##   · `pillar`：石柱没有"人"可言，整根柱子就是它的 `Body`（并且整根吃队伍色，见 `PILLAR_*` 段）。
const NO_HUMANOID_TYPES := ["catapult", "ballista", "sandworm", "shadow", "pillar", "commandpost",
		"doom_eye"]
## **照建骨架、但"头 / 鼻尖"由模型自己接管**的兵种（2026-09-25 第二轮起；第三轮加进影魔 `shadow`）。
## ⚠️ 为什么不把它们塞进 `NO_HUMANOID_TYPES`：那样会连**躯干一起跳过**，而躯干是这些模型的载体 ——
##   ① **队伍色**（`00_world.md#4.3`；`01_core_loop.md#2` 的色盲测试先看它）。
##      腐化师是深紫长袍 + 兜帽、手雷王是奶油色球身 + 白玉面具、影魔是近黑的头 / 披风 / 暗影下半身，
##      三者**都刻意不吃队伍色**（与火焰拳的帽 / 袍 / 火同一条口径：兵种特征不抢队伍色）
##      ⇒ 队伍色就只剩躯干这一个锚点（影魔另加一条腰际束带 `WaistSash`，见 `SHADOW_*` 段）；
##   ② `unit3d.gd#_ready()` 的 `_visual.find_child("Body", true, false)` —— **受击闪白**靠它。
##      没有躯干 = 这些兵种挨打时不闪白（不报错、只是不闪，最难发现的那类回归）。
## ⚠️ 只跳过两件：
##   · **头**（`Head`）：腐化师的兜帽是一颗从肩头罩到顶的钝锥（顶 1.86 盖过骨架头顶 1.80）、
