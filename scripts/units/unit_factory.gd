			## ② 眼球：**整颗吃队伍色**（队伍色第一锚点，也是闪白的载体）
			var core := _mesh("Body", SphereMesh.new(), base)
			var core_mesh: SphereMesh = core.mesh
			core_mesh.radius = DOOM_CORE_R
			core_mesh.height = DOOM_CORE_R * 2.0
			core_mesh.radial_segments = 24
			core_mesh.rings = 12
			core.position = Vector3(0.0, DOOM_CORE_Y, 0.0)
			visual.add_child(core)
			## ③ 贴地光环（**队伍色锚点之二**）：乱战里一眼看出"这只眼是谁的"。
			## ⚠️ 名字以 `TeamAccent` 开头 ⇒ 换边时由 `unit3d.gd#_repaint_team_accents()` 显式重绘。
			var doom_ring := _mesh("TeamAccent_Ring", CylinderMesh.new(), base)
			var doom_ring_mesh: CylinderMesh = doom_ring.mesh
			doom_ring_mesh.top_radius = DOOM_RING_R
			doom_ring_mesh.bottom_radius = DOOM_RING_R
			doom_ring_mesh.height = DOOM_RING_THICK
			doom_ring_mesh.radial_segments = 32
			doom_ring.position = Vector3(0.0, DOOM_RING_THICK * 0.5, 0.0)
			(doom_ring.material_override as StandardMaterial3D).emission_energy_multiplier = 1.6
			visual.add_child(doom_ring)
			## ④ 瞳孔组（`weapon` = `GazePivot`）：**它的原点就落在瞳孔中心那颗光点的球心上** ——
			##    这样 `unit3d.gd#_update_laser_beam()` 取的 `_weapon.global_position` 正是"瞳孔"，
			##    激光视觉上就是**从瞳孔里射出来**的（石柱那颗晶体、腐化师那颗棱镜都是同一套约定）。
			##    整组**绕 X 轴抬起 `DOOM_GAZE_PITCH`** ⇒ 静止时它朝斜上方"望"（用户第十一轮的原话"向上看的"）。
			##    ⚠️ 三件沿"视线方向"排开：光点最前、瞳孔往后 `DOOM_PUPIL_BACK`、虹膜再往后 `DOOM_IRIS_BACK`
			##    ⇒ 从正面看是"虹膜圆盘里一个黑瞳孔、瞳孔中心一颗青白光点"（`GazePivot` 的局部 −Z 就是视线）。
			##    ⚠️ **"绕到身后也能持续锁定"不靠这个 pivot**：锁定 / 光束判据里没有任何朝向条件，
			##    单位每帧由 `_face()` 转身朝向目标 ⇒ 目标在背后照样锁、照样照（判据第十一轮静态核对过；
			##    ⚠️ 那一轮跑不了引擎 ⇒ **实机复核待补**）。
			weapon = Node3D.new()
			weapon.name = "GazePivot"
			## 视线的单位向量 = 绕 X 抬 `DOOM_GAZE_PITCH` 之后的局部 −Z（与下面 `weapon.rotation` 严格同源）
			var gaze_dir := Vector3(0.0, sin(DOOM_GAZE_PITCH), -cos(DOOM_GAZE_PITCH))
			weapon.position = Vector3(0.0, DOOM_CORE_Y, 0.0) + gaze_dir * DOOM_GLINT_OUT
			weapon.rotation = Vector3(DOOM_GAZE_PITCH, 0.0, 0.0)
			## 光点：瞳孔正中心那一颗青白自发光（"瞳"的视觉焦点 = `weapon` 的原点）
			var glint := _mesh("Glint", SphereMesh.new(), DOOM_GLOW_COLOR)
			var glint_mesh: SphereMesh = glint.mesh
			glint_mesh.radius = DOOM_GLINT_R
			glint_mesh.height = DOOM_GLINT_R * 2.0
			glint_mesh.radial_segments = 16
			glint_mesh.rings = 8
			(glint.material_override as StandardMaterial3D).emission_energy_multiplier = DOOM_GLOW_ENERGY
			weapon.add_child(glint)
