	## 2026-09-24：载具整体抬起 `VEHICLE_LIFT`（见常量处的说明）——修"整台机器陷进地里 0.4 m"。
	## 放大之后机器内部偏移跟着 ×`VEHICLE_SCALE`，所以抬升量也要同步乘上去，否则轮子又会陷回地里。
	if VEHICLE_TYPES.has(type_id):
		visual.scale = Vector3.ONE * VEHICLE_SCALE
		## 2026-09-24：载具抬起量**按兵种**取值（`VEHICLE_LIFT_BY_TYPE`，标定见常量处），再乘放大倍数。
		visual.position.y += float(VEHICLE_LIFT_BY_TYPE.get(type_id, VEHICLE_LIFT_DEFAULT)) * VEHICLE_SCALE
		## ⚠️ 2026-09-24：先按"整台机器前后对调"翻过 180°，随后用户澄清"**兜应该在我方这侧**，不是敌方"
		## ⇒ 翻转解决不了问题（它只是把整台车掉头）。正解是**抛臂的静止姿态**：
		## 兜在**车尾（我方这侧）高举**（= 抛石机"过顶抛"的待发姿态），出手时才向前上方划过去。
		## 故此处**不翻转**，改由 `SIEGE_ARM_REST_ANGLE` 控制姿态。


	## 剑圣的**刀光环**（2026-09-27 第十二轮·第二批，「剑圣」科技）：**每个剑盾兵都建好、出厂即隐藏** ——
	## 只有买到该科技、且被标成剑圣的那一个单位会把它点亮（`unit3d.gd#_update_saint_spin()`）。
	## ⚠️ 为什么给**所有**剑盾兵都建、而不是"升级那一刻现造"：本项目刻意不在运行时造网格 / 材质 ——
	## 新的网格 + 材质组合 = 首次绘制时现编译着色器（沙盒里第一次摆某个兵种会卡一整帧，见 `02_entities.md#2.5`）。
	## 一个隐藏的 `TorusMesh` 代价可忽略，而"买科技那一刻现造"的卡顿正好落在玩家的操作上。
	## ⚠️ 半径取**常数**（= 剑圣 2 × 剑盾兵射程 × 接触宽容 ≈ 5.19 m）：它只是"扫过一圈"的视觉提示，
	## 真正的判定半径由 `_resolve_cone_attack(360°)` 现算，两者不互相依赖。
	_attach_skill_fx(type_id, visual, weapon)

	if type_id == "sword":
		var ring := _mesh("SlashRing", TorusMesh.new(), base)
		var ring_mesh: TorusMesh = ring.mesh
		ring_mesh.inner_radius = SLASH_RING_R - SLASH_RING_TUBE
		ring_mesh.outer_radius = SLASH_RING_R + SLASH_RING_TUBE
		ring_mesh.rings = 48
		ring_mesh.ring_segments = 8
		ring.position = Vector3(0.0, SLASH_RING_Y, 0.0)
		(ring.material_override as StandardMaterial3D).emission_energy_multiplier = 1.6
		ring.visible = false
		visual.add_child(ring)

	## 骑乘：武器与骑手同属上半身，必须**一起抬上去**（否则冲枪会停在马肚子高度）。
	## ⚠️ 用"事后改挂"而不是去改 12 个 `match` 分支里的 `visual.add_child(weapon)`：
	## `add_child` 会**保留局部变换**，所以武器的 `position` / `rotation` 一字不动，
	## `unit3d.gd` 缓存的 `_weapon_rest_pos`（局部坐标）也照样成立 ⇒ 突刺动画不受影响。
	## 非骑乘兵种 `rider == null` ⇒ 这一段整段跳过（逐位不变）。
	if rider != null and weapon != null:
		visual.remove_child(weapon)
		rider.add_child(weapon)

	return {"visual": visual, "weapon": weapon, "shield": shield}

## 出厂就挂上、默认隐藏。买到对应科技或技能进入那一段时再点亮，避免开战中途现造网格。
static func _attach_skill_fx(type_id: String, visual: Node3D, weapon: Node3D) -> void:
	if type_id == "sword" and weapon != null:
		var fire := Node3D.new()
		fire.name = "FireEdge"
		fire.visible = false
		var flame := Color(1.0, 0.38, 0.08)
		for i in 3:
			var tongue := CylinderMesh.new()
			tongue.top_radius = 0.0
			tongue.bottom_radius = 0.07
			tongue.height = 0.22
			tongue.radial_segments = 6
			var tip := _fx_mesh("FireTongue_%d" % i, tongue, flame, true)
			tip.rotation = Vector3(PI * 0.5, 0.0, 0.0)
			tip.position = Vector3(0.0, 0.08, -0.28 - 0.22 * float(i))
			fire.add_child(tip)
		weapon.add_child(fire)
	if type_id == "knight":
		var ring_mesh := TorusMesh.new()
		ring_mesh.inner_radius = 0.85
		ring_mesh.outer_radius = 1.15
		ring_mesh.rings = 24
		ring_mesh.ring_segments = 6
		var ring := _fx_mesh("BulwarkRing", ring_mesh, Color(0.45, 0.82, 1.0), false)
		ring.position = Vector3(0.0, 0.08, 0.0)
		ring.visible = false
		visual.add_child(ring)
	if type_id == "master":
		var iai := Node3D.new()
		iai.name = "IaiFx"
		var charge_mesh := TorusMesh.new()
		charge_mesh.inner_radius = 0.7
		charge_mesh.outer_radius = 1.05
		charge_mesh.rings = 24
		charge_mesh.ring_segments = 6
		var charge := _fx_mesh("IaiCharge", charge_mesh, Color(0.95, 0.82, 0.35), true)
		charge.position = Vector3(0.0, 0.1, 0.0)
		charge.visible = false
		iai.add_child(charge)
		var dash_mesh := BoxMesh.new()
		dash_mesh.size = Vector3(0.35, 0.08, 3.2)
		var dash := _fx_mesh("IaiDash", dash_mesh, Color(0.95, 0.95, 1.0), true)
		dash.position = Vector3(0.0, 1.0, 1.2)
		dash.visible = false
		iai.add_child(dash)
		var slash_mesh := TorusMesh.new()
		slash_mesh.inner_radius = 1.1
		slash_mesh.outer_radius = 1.45
		slash_mesh.rings = 28
		slash_mesh.ring_segments = 6
		var slash := _fx_mesh("IaiSlash", slash_mesh, Color(1.0, 0.92, 0.55), true)
		slash.position = Vector3(0.0, 1.05, 0.0)
		slash.visible = false
		iai.add_child(slash)
		visual.add_child(iai)
	if type_id == "berserker":
		var aura_mesh := SphereMesh.new()
		aura_mesh.radius = 0.85
		aura_mesh.height = 1.7
		aura_mesh.radial_segments = 12
		aura_mesh.rings = 8
		var aura := _fx_mesh("EmberAura", aura_mesh, Color(1.0, 0.28, 0.05), true)
		aura.position = Vector3(0.0, 0.9, 0.0)
		aura.visible = false
		visual.add_child(aura)

## 影魔的一片"影子构件"（2026-09-25 第七轮抽出：影摆 10 片与双臂 2 片**共用这一条算式**）。
## `spec` = `Vector4(方位角 rad, 上口高度 m, 棱长 m, 张开角 rad)`，方位角 0 = 正前 −Z。
## 形状：一根**收成尖的细锥**（宽端 = `root_r`、尖 = 0），宽端钉在"中轴 + 半径 `ring_r`"的圈上、尖朝外下方。
## ⚠️ Euler YXZ 下 `rotation = (张开角, 方位角, 0)` 一次给出两件事：**局部 −Y（尖）**被送到
## "方位 `azimuth` 那一侧的斜下方"，局部 +Y（宽端）落在 `axis` 上 ⇒ 锥心 = 宽端 − 轴 × 半长
##（与扇骨 / 三角帽檐 / 弩车弓臂段同一套"先俯仰再偏航"的手法）。
## ⚠️ 颜色由调用方决定？不 —— 这一族**只有墨色**（它是影子的一部分），要亮部就用别的件（拖尾 / 披风）。
static func _shadow_wisp(node_name: String, spec: Vector4, ring_r: float, root_r: float) -> MeshInstance3D:
	var azimuth := spec.x
	var top_y := spec.y
	var length := spec.z
	var tilt := spec.w
	var side_dir := Vector3(-sin(azimuth), 0.0, -cos(azimuth))
	var wisp := _mesh(node_name, CylinderMesh.new(), SHADOW_INK)
	var wisp_mesh: CylinderMesh = wisp.mesh
	wisp_mesh.top_radius = root_r
	wisp_mesh.bottom_radius = 0.0
	wisp_mesh.height = length
	wisp_mesh.radial_segments = 8
	wisp.rotation = Vector3(tilt, azimuth, 0.0)
	var axis := Vector3(-sin(tilt) * side_dir.x, cos(tilt), -sin(tilt) * side_dir.z)
	wisp.position = Vector3(side_dir.x * ring_r, top_y, side_dir.z * ring_r) - axis * (length * 0.5)
	return wisp

## 火焰拳的**斗笠**（2026-09-19 第二轮建模，用户："帽子应类似于斗笠，帽尖高度降低，帽檐略下垂"）。
## 手搓一个**旋转面**（lathe）：把一条轮廓线绕 Y 轴转一圈。
##   · 局部原点 = **帽尖**（调用方直接把它摆到头顶高度）；
##   · 轮廓 (半径, 相对帽尖的高度)：一路压低，**越靠边越陡**，最后 1/5 半径压出明显的垂檐。
## ⚠️ 为什么不用基础网格：`CylinderMesh` 的母线是**直线**，做不出"檐口下弯"这道弧
##（那样只会得到第二个圆锥，和扇子兵的斗笠更难区分）。
## ⚠️ 正反两面都建了三角形（与 `_fan_face_mesh()` 同一手法）⇒ 从下往上看不会看穿；
##    法线交给 `generate_normals()` 按绕序算 ⇒ 两面各自被正确照亮。
static func _straw_hat_mesh() -> ArrayMesh:
	const SEGMENTS := 20
	var profile: Array[Vector2] = [
		Vector2(0.00, 0.000), Vector2(0.08, -0.020), Vector2(0.16, -0.045),
		Vector2(0.24, -0.075), Vector2(0.32, -0.110), Vector2(0.39, -0.148),
		Vector2(0.44, -0.180), Vector2(0.47, -0.212), Vector2(0.50, -0.255),
	]
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for k in SEGMENTS:
		var a0 := TAU * float(k) / float(SEGMENTS)
		var a1 := TAU * float(k + 1) / float(SEGMENTS)
		for i in profile.size() - 1:
			var inner: Vector2 = profile[i]
			var outer: Vector2 = profile[i + 1]
			var v00 := Vector3(cos(a0) * inner.x, inner.y, sin(a0) * inner.x)
			var v01 := Vector3(cos(a0) * outer.x, outer.y, sin(a0) * outer.x)
			var v10 := Vector3(cos(a1) * inner.x, inner.y, sin(a1) * inner.x)
			var v11 := Vector3(cos(a1) * outer.x, outer.y, sin(a1) * outer.x)
			## 外表面一片（两个三角）
			st.add_vertex(v00)
			st.add_vertex(v01)
			st.add_vertex(v11)
			st.add_vertex(v00)
			st.add_vertex(v11)
			st.add_vertex(v10)
			## 内表面一片：绕序整体反过来
			st.add_vertex(v00)
			st.add_vertex(v11)
			st.add_vertex(v01)
			st.add_vertex(v00)
			st.add_vertex(v10)
			st.add_vertex(v11)
	st.generate_normals()
	return st.commit()

## 马（纯表现，2026-09-25 第三条 —— 用户："修改轻骑兵建模，要骑马"）。
## 拼装顺序 = 从下往上、从后往前：四条腿 → 躯干 → 鞍垫 / 护毯 / 马镫 → 前倾的颈 → 头 → 口鼻 → 双耳 → 尾。
## ⚠️ **朝向与兵种一致：头朝 −Z**（不变量 I-30「选手正面是自身 −Z」）——
##   所以前腿在 −Z、马头在 −Z，与骑手的鼻尖同侧；马一旦反过来就是"倒着跑"。
## ⚠️ **队伍色落在鞍垫与两侧护毯上**：骑手的躯干（原先唯一的队伍色载体）被抬到上半身之后，
##   远看只剩一小块 ⇒ 马身必须补一个队伍色锚点，否则色盲测试（`01_core_loop.md#2`）会先输在队伍识别上。
##   马毛本身取低饱和深棕（`MOUNT_HIDE`），刻意与队伍色拉开。
## ⚠️ **零碰撞体**：这里只 `_mesh()`，绝不建 `StaticBody3D` / `Area3D`；
##   命中与被命中仍完全由 `unit3d.gd` 的胶囊（0.38 / 1.80）决定（用户裁定"判定体不变"）。
static func _mount_xform(pos: Vector3, rot: Vector3 = Vector3.ZERO) -> Transform3D:
	return Transform3D(Basis.from_euler(rot), pos)

static func _mount_cylinder(top_r: float, bot_r: float, height: float, segs: int) -> CylinderMesh:
	var mesh := CylinderMesh.new()
	mesh.top_radius = top_r
	mesh.bottom_radius = bot_r
	mesh.height = height
	mesh.radial_segments = segs
	return mesh

static func _mount_box(size: Vector3) -> BoxMesh:
	var mesh := BoxMesh.new()
	mesh.size = size
	return mesh

static func _mount_part(mesh: Mesh, xform: Transform3D, color: Color) -> Dictionary:
	return {"mesh": mesh, "xform": xform, "color": color}

## 同色零件合成一张网格的一个表面。`MountDetail` 留给远处隐藏。
static func _commit_mount(parent: Node3D, node_name: String, parts: Array) -> void:
	var grouped: Dictionary = {}
	var order: Array[String] = []
	for part in parts:
		var color: Color = part["color"]
		var key := color.to_html(false)
		if not grouped.has(key):
			var fresh := SurfaceTool.new()
			fresh.begin(Mesh.PRIMITIVE_TRIANGLES)
			grouped[key] = {"tool": fresh, "color": color}
			order.append(key)
		var tool: SurfaceTool = grouped[key]["tool"]
		var part_mesh: Mesh = part["mesh"]
		var part_xform: Transform3D = part["xform"]
		tool.append_from(part_mesh, 0, part_xform)
	var array_mesh := ArrayMesh.new()
	var mi := MeshInstance3D.new()
	mi.name = node_name
	mi.mesh = array_mesh
	var surface_i := 0
	for key in order:
		var baked: SurfaceTool = grouped[key]["tool"]
		baked.generate_normals()
		baked.commit(array_mesh)
		var baked_color: Color = grouped[key]["color"]
		var mat := StandardMaterial3D.new()
		mat.albedo_color = baked_color
		mat.roughness = 0.85
		mat.emission_enabled = true
		mat.emission = baked_color
		mat.emission_energy_multiplier = 0.28
		mi.set_surface_override_material(surface_i, mat)
		surface_i += 1
	parent.add_child(mi)

static func _build_mount(parent: Node3D, base: Color, metal: Color) -> void:
	## 轮廓（腿、躯干、鞍、颈、头）和零件（白袜、护毯、镫、鬃、白斑、口鼻、耳、尾）各合成一张网格。
	## 远处只藏零件，骑手仍骑在能认出的马上。
	var body: Array = []
	var detail: Array = []
	for side in ["left", "right"]:
		for end in ["front", "rear"]:
			var leg_x := -MOUNT_LEG_HALF_X if side == "left" else MOUNT_LEG_HALF_X
			var leg_z := -MOUNT_LEG_HALF_Z if end == "front" else MOUNT_LEG_HALF_Z
			body.append(_mount_part(
					_mount_cylinder(MOUNT_LEG_RADIUS, MOUNT_LEG_RADIUS * 0.82, MOUNT_LEG_LENGTH, 8),
					_mount_xform(Vector3(leg_x, MOUNT_LEG_LENGTH * 0.5, leg_z)),
					MOUNT_HIDE))
			detail.append(_mount_part(
					_mount_cylinder(MOUNT_LEG_RADIUS * 0.98, MOUNT_LEG_RADIUS * 0.84, MOUNT_SOCK_HEIGHT, 8),
					_mount_xform(Vector3(leg_x, MOUNT_SOCK_HEIGHT * 0.5, leg_z)),
					MOUNT_BLAZE))
	body.append(_mount_part(
			_mount_cylinder(MOUNT_BARREL_RADIUS, MOUNT_BARREL_RADIUS, MOUNT_BARREL_LENGTH, 10),
			_mount_xform(Vector3(0.0, MOUNT_BARREL_Y, 0.04), Vector3(PI * 0.5, 0.0, 0.0)),
			MOUNT_HIDE))
	body.append(_mount_part(
			_mount_box(Vector3(0.56, 0.10, 0.78)),
			_mount_xform(Vector3(0.0, MOUNT_BARREL_Y + 0.30, 0.02)),
			base))
	for side in ["left", "right"]:
		var out_x := -1.0 if side == "left" else 1.0
		detail.append(_mount_part(
				_mount_box(Vector3(0.03, 0.40, 0.68)),
				_mount_xform(Vector3(out_x * (MOUNT_BARREL_RADIUS + 0.02), MOUNT_BARREL_Y + 0.04, 0.02)),
				base))
		detail.append(_mount_part(
				_mount_box(Vector3(0.11, 0.03, 0.18)),
				_mount_xform(Vector3(out_x * (MOUNT_BARREL_RADIUS + 0.07), MOUNT_BARREL_Y - 0.20, -0.04)),
				metal))
	var neck_xf := _mount_xform(Vector3(0.0, MOUNT_BARREL_Y + 0.24, -0.56), Vector3(MOUNT_NECK_ANGLE, 0.0, 0.0))
	body.append(_mount_part(_mount_box(Vector3(0.28, 0.92, 0.36)), neck_xf, MOUNT_HIDE))
	## 鬃毛原来挂在颈下面，跟着颈的倾角转。合成时把颈的变换乘进去。
	detail.append(_mount_part(
			_mount_box(Vector3(0.11, 0.92, 0.14)),
			neck_xf * _mount_xform(Vector3(0.0, 0.04, 0.17)),
			MOUNT_HAIR))
	body.append(_mount_part(
			_mount_box(Vector3(0.21, 0.26, 0.52)),
			_mount_xform(Vector3(0.0, MOUNT_HEAD_Y, MOUNT_HEAD_Z)),
			MOUNT_HIDE))
	detail.append(_mount_part(
			_mount_box(Vector3(0.075, 0.24, 0.10)),
			_mount_xform(Vector3(0.0, MOUNT_HEAD_Y - 0.02, MOUNT_HEAD_Z - 0.24)),
			MOUNT_BLAZE))
	detail.append(_mount_part(
			_mount_box(Vector3(0.17, 0.17, 0.22)),
			_mount_xform(Vector3(0.0, MOUNT_HEAD_Y - 0.05, MOUNT_HEAD_Z - 0.34)),
			MOUNT_BLAZE))
	for side in ["left", "right"]:
		detail.append(_mount_part(
				_mount_box(Vector3(0.055, 0.18, 0.055)),
				_mount_xform(
						Vector3(-0.075 if side == "left" else 0.075, MOUNT_HEAD_Y + 0.20, MOUNT_HEAD_Z + 0.16),
						Vector3(-0.12, 0.0, 0.0)),
				MOUNT_HIDE))
	detail.append(_mount_part(
			_mount_box(Vector3(0.12, 0.12, 0.56)),
			_mount_xform(
					Vector3(0.0, MOUNT_BARREL_Y + 0.26, MOUNT_BARREL_LENGTH * 0.5 + 0.10),
					Vector3(MOUNT_TAIL_ANGLE, 0.0, 0.0)),
			MOUNT_HAIR))
	_commit_mount(parent, "MountBody", body)
	_commit_mount(parent, "MountDetail", detail)

## 通道 ② 头盔：三种兵各一件**形状不同**的头饰。
## 远距离下头顶轮廓往往比躯干更早被认出来，所以三种形状刻意做得互不相同：
## 剑盾兵 = 圆顶金属盔 / 长矛兵 = 尖顶金属盔 / 短弓手 = 布兜帽（无金属）。
## 2026-09-25 新增两顶：长弓手 = 宽檐猎帽 / 轻骑兵（矛）= 前倾盔缨的轻盔。
static func _headgear(type_id: String, visual: Node3D, metal: Color, cloth: Color) -> void:
	match type_id:
		"sword":
			var dome := _mesh("Helmet", SphereMesh.new(), metal)
