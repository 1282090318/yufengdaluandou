		"shortbow":
			var hood := _mesh("Hood", CylinderMesh.new(), cloth)
			var hood_mesh: CylinderMesh = hood.mesh
			hood_mesh.top_radius = 0.06
			hood_mesh.bottom_radius = 0.245
			hood_mesh.height = 0.46
			hood_mesh.radial_segments = 10
			hood.position = Vector3(0.0, 1.72, 0.05)
			visual.add_child(hood)
		"longbow":
			## 长弓手（2026-09-25 新增）：**宽檐猎帽**（扁圆锥 + 一圈帽箍），与短弓手的窄布兜帽同色系
			## 但轮廓完全不同（宽檐外扩 ⇒ 头顶读起来是"一个横向的盘子"而不是"一个竖着的口袋"）。
			## 通道 ② 的规则是"形状互不相同"：这一顶的形状（扁宽檐）在场上没有第二件。
			var brim := _mesh("HunterBrim", CylinderMesh.new(), cloth)
			var brim_mesh: CylinderMesh = brim.mesh
			brim_mesh.top_radius = 0.10
			brim_mesh.bottom_radius = 0.40
			brim_mesh.height = 0.14
			brim_mesh.radial_segments = 12
			brim.position = Vector3(0.0, 1.80, 0.04)
			visual.add_child(brim)
			var crown := _mesh("HunterCrown", CylinderMesh.new(), cloth)
			var crown_mesh: CylinderMesh = crown.mesh
			crown_mesh.top_radius = 0.15
			crown_mesh.bottom_radius = 0.20
			crown_mesh.height = 0.20
			crown_mesh.radial_segments = 10
			crown.position = Vector3(0.0, 1.93, 0.04)
			visual.add_child(crown)
			## 帽箍：一圈深皮革色，把宽檐与帽冠之间切开（`_headgear()` 只拿到 metal / cloth 两个色，
			## 这里用与火焰拳帽箍同一手法——就地取一个色，不改函数签名）
			var band := _mesh("HunterBand", CylinderMesh.new(), Color(0.40, 0.27, 0.15))
			var band_mesh: CylinderMesh = band.mesh
			band_mesh.top_radius = 0.205
			band_mesh.bottom_radius = 0.205
			band_mesh.height = 0.05
			band_mesh.radial_segments = 12
			band.position = Vector3(0.0, 1.86, 0.04)
			visual.add_child(band)
		"lightcav":
			## 轻骑兵（矛）（2026-09-25 新增）：**前倾盔缨**的轻盔 —— 头盔本身是低矮的圆筒，
			## 辨识度全在那片**向前压下去**的缨上（+Z 侧低、−Z 侧高 ⇒ 读起来是"正在往前冲"）。
			## ⚠️ 它与骑士那顶"大盔 + 竖直盔缨"的差别刻意做在两个地方：**低**（0.34 对 0.52）
			## 与**前倾**（骑士的缨是竖直的一块板）；两者远看不会混。
			var light_helm := _mesh("LightHelm", CylinderMesh.new(), metal)
			var light_helm_mesh: CylinderMesh = light_helm.mesh
