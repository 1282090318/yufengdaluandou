			light_helm_mesh.bottom_radius = 0.225
			light_helm_mesh.height = 0.34
			light_helm_mesh.radial_segments = 10
			light_helm.position = Vector3(0.0, 1.72, 0.03)
			visual.add_child(light_helm)
			var mane := _mesh("CrestMane", BoxMesh.new(), cloth)
			(mane.mesh as BoxMesh).size = Vector3(0.06, 0.30, 0.44)
			mane.rotation = Vector3(-0.62, 0.0, 0.0)      # 前倾：缨尖朝 −Z（自身正面）
			mane.position = Vector3(0.0, 1.94, 0.06)
			visual.add_child(mane)
		"flamefist":
			## 火焰拳（2026-09-19 建模第二轮，用户："帽子应类似于斗笠，帽尖高度降低，帽檐略下垂"）：
			## **黑斗笠**（手搓旋转面，见 `_straw_hat_mesh()`）+ 一圈正红帽箍 + 檐上六片火纹。
			## 帽尖 1.99（比上一版的帽顶 2.07 **低 8 cm**），檐口 1.735 = 刚好压到眉上（眼睛 1.665 露在外面）。
			## ⚠️ 与扇子兵那顶斗笠（`#fan` 的 `StrawHat`，草黄**直圆锥**）的区分全靠颜色与轮廓：
			##   ① 近黑（0.13/0.12/0.14）对上草黄（0.72/0.63/0.42）；
			##   ② 弧面垂檐 + 红帽箍 + 六片火纹 对上一根直线母线。
			##   **"两者都是锥形"是用户明确要点**（通道 ② 的"形状互不相同"因此让位，已登记进漂移清单）。
			var hat_black := Color(0.13, 0.12, 0.14)
			var hat := _mesh("ConeHat", _straw_hat_mesh(), hat_black)
			hat.position = Vector3(0.0, 1.99, 0.0)     ## 网格局部原点 = 帽尖
			visual.add_child(hat)
			## 帽箍：箍在锥面上的一道正红（半径比该处锥面略大 1 cm ⇒ 侧面看得到一圈红环）
			var hat_band := _mesh("HatBand", CylinderMesh.new(), Color(0.78, 0.14, 0.12))
			var band_mesh: CylinderMesh = hat_band.mesh
			band_mesh.top_radius = 0.262
			band_mesh.bottom_radius = 0.262
			band_mesh.height = 0.022
			band_mesh.radial_segments = 16
			hat_band.position = Vector3(0.0, 1.912, 0.0)
			visual.add_child(hat_band)
			## 檐上六片火纹：**贴着锥面**躺下 —— 该处母线约向下 28°，
			## 于是三棱柱的尖（+Y）先绕 X 转 118.5°（= 90° + 28.5°：尖端朝外且略朝下），再绕 Y 转到方位上。
			for k in 6:
				var a := TAU * float(k) / 6.0 + PI * 0.5
				var dir := Vector3(cos(a), 0.0, sin(a))
				var motif := _mesh("HatFlame_%d" % k, PrismMesh.new(),
						Color(1.00, 0.42, 0.12) if k % 2 == 0 else Color(0.86, 0.20, 0.08))
				(motif.mesh as PrismMesh).size = Vector3(0.16, 0.26, 0.05)
				motif.rotation = Vector3(deg_to_rad(118.5), PI * 0.5 - a, 0.0)
				motif.position = Vector3(dir.x * 0.36, 1.855, dir.z * 0.36)
				visual.add_child(motif)
		"musket":
			## 火枪兵（2026-09-25 新增）：**三角帽** —— 矮圆筒帽冠 + **三片向上翻起的帽檐** + 正前方一枚帽徽。
			## 通道 ② 的规矩是"形状互不相同"，这一顶的形状（**檐往上折**、俯看是个三角形）场上没有第二件：
			## 长弓手的宽檐是**向下斜铺**的扁锥（横向的盘子）、火焰拳的斗笠是**垂檐**、短弓手是收口的布兜帽 ——
			## 三者的檐朝向两两不同 ⇒ 不看颜色也能从"檐往上还是往下"一眼分开。
			var felt := Color(0.22, 0.21, 0.20)     ## 毡帽：近黑（帽子是兵种特征、不吃队伍色，与火焰拳的斗笠同一档）
			var crown := _mesh("TricorneCrown", CylinderMesh.new(), felt)
			var crown_mesh: CylinderMesh = crown.mesh
			crown_mesh.top_radius = 0.165
			crown_mesh.bottom_radius = 0.205
			crown_mesh.height = 0.20
			crown_mesh.radial_segments = 12
			crown.position = Vector3(0.0, 1.84, 0.02)
			visual.add_child(crown)
			## 三片翻檐：每片先挂在一个**只做偏航**的枢轴上 —— 枢轴原地绕 Y 转到自己的方位，
			## 檐板再绕 X 转 −38° ⇒ **外沿向上翘起**（负角把檐板局部 +Z 那一端抬起来）。
			## k = 0 那一片正对 −Z（自身正面），另两片在 ±120°。
			## ⚠️ 枢轴的偏航角写成 `PI * 0.5 - 方位角`：Euler YXZ 下这是"把局部 +Z 转到该方位"的解
			## （与弩车弓臂段、扇子兵扇骨同一套"先俯仰再偏航"的手法）。
			for k in 3:
				var flap_yaw := -PI * 0.5 + TAU * float(k) / 3.0
				var flap_pivot := Node3D.new()
				flap_pivot.name = "TricorneFlap_%d" % k
				flap_pivot.rotation = Vector3(deg_to_rad(-38.0), PI * 0.5 - flap_yaw, 0.0)
				flap_pivot.position = Vector3(cos(flap_yaw) * 0.17, 1.79, sin(flap_yaw) * 0.17)
				var flap := _mesh("TricorneFlapPlate_%d" % k, BoxMesh.new(), felt)
				(flap.mesh as BoxMesh).size = Vector3(0.34, 0.035, 0.24)
				flap.position = Vector3(0.0, 0.0, 0.13)      ## 枢轴局部 +Z = 帽檐朝外的方向
				flap_pivot.add_child(flap)
				visual.add_child(flap_pivot)
			## 帽徽：正前那一片檐的**外侧面**上一枚浅色圆徽（近黑帽子上唯一的亮点，也把"正面"标出来）。
			## 坐标 = 檐面中心 (0, 1.87, −0.272) + 檐面外法线 (0, −0.79, −0.62) × 0.035。
			var cockade := _mesh("Cockade", SphereMesh.new(), Color(0.88, 0.85, 0.78))
			var cockade_mesh: SphereMesh = cockade.mesh
			cockade_mesh.radius = 0.048
			cockade_mesh.height = 0.096
			cockade_mesh.radial_segments = 10
			cockade_mesh.rings = 5
			cockade.position = Vector3(0.0, 1.842, -0.294)
			visual.add_child(cockade)
		"master":
			## 武士大师（2026-09-25 新增）：**高束发 + 额带** —— 全场唯一一顶"头上再竖一根杆"的头饰。
			## 通道 ② 的差别刻意做在**高度与垂直感**上：骑士的盔缨（板高 0.26、顶 2.18）与轻骑兵的前倾缨
			## 都只有一小片，这里是一根**半径 0.06** 的**发柱**顶着一颗发髻，最高点 ≈2.21 m，
			## 远看就是"头顶上多出一个黑点竖着" ⇒ 不看颜色、不看武器也能从剪影上认出来。
			## 额带是一圈**浅色**窄箍（+ 脑后的结）：近黑头发 / 浅色额带在头顶形成两道横线，
			## 把"发"与"脸"分开 —— 与火焰拳那圈正红帽箍的区别在**位置**（额上 vs 帽檐上）与**颜色**。
			var hair := Color(0.13, 0.11, 0.10)          ## 近黑（与 `MOUNT_HAIR` 同色：本文件里"毛发"统一取这一档）
			var band_color := Color(0.86, 0.83, 0.76)    ## 额带 / 束发绳：浅色（与马脸白斑同一档的对比度来源）
			var band := _mesh("HeadBand", CylinderMesh.new(), band_color)
			var band_mesh: CylinderMesh = band.mesh
			band_mesh.top_radius = 0.280
			band_mesh.bottom_radius = 0.280
			band_mesh.height = 0.08
			band_mesh.radial_segments = 14
			band.position = Vector3(0.0, 1.71, 0.02)
			visual.add_child(band)
			## 脑后的结：从背后看也有一个明确的"带子系住了"的点，而不是一圈凭空箍着的箍
			var band_knot := _mesh("HeadBandKnot", BoxMesh.new(), band_color)
			(band_knot.mesh as BoxMesh).size = Vector3(0.12, 0.10, 0.09)
			band_knot.position = Vector3(0.0, 1.71, 0.29)
			visual.add_child(band_knot)
			## 束发绳：把发根扎起来的一小圈浅色绳（与额带同色 ⇒ 读起来是"同一条带子"）
			var knot_tie := _mesh("TopKnotTie", CylinderMesh.new(), band_color)
			var tie_mesh: CylinderMesh = knot_tie.mesh
			tie_mesh.top_radius = 0.075
			tie_mesh.bottom_radius = 0.082
			tie_mesh.height = 0.09
			tie_mesh.radial_segments = 10
			knot_tie.position = Vector3(0.0, 1.92, 0.0)
			visual.add_child(knot_tie)
			## 发柱 + 发髻：这两件才是"高束发"的本体（**竖直向上**，不学轻骑兵的缨往前压）
			var topknot := _mesh("TopKnotHair", CylinderMesh.new(), hair)
			var topknot_mesh: CylinderMesh = topknot.mesh
			topknot_mesh.top_radius = 0.052
			topknot_mesh.bottom_radius = 0.060
			topknot_mesh.height = 0.17
			topknot_mesh.radial_segments = 8
			topknot.position = Vector3(0.0, 2.02, 0.0)
			visual.add_child(topknot)
			var bun := _mesh("TopKnotBun", SphereMesh.new(), hair)
			var bun_mesh: SphereMesh = bun.mesh
			bun_mesh.radius = 0.080
			bun_mesh.height = 0.16
			bun_mesh.radial_segments = 10
			bun_mesh.rings = 5
			bun.position = Vector3(0.0, 2.13, 0.0)
