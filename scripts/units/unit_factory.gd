			crest.position = Vector3(0.0, 2.05, 0.03)
			visual.add_child(crest)
		"fan":
			## 扇子兵（2026-09-18）：**斗笠**（宽而扁的圆锥），与短弓手的布兜帽区分开。
			var hat := _mesh("StrawHat", CylinderMesh.new(), Color(0.72, 0.63, 0.42))
			var hat_mesh: CylinderMesh = hat.mesh
			hat_mesh.top_radius = 0.05
			hat_mesh.bottom_radius = 0.46
			hat_mesh.height = 0.22
			hat_mesh.radial_segments = 12
			hat.position = Vector3(0.0, 1.78, 0.03)
			visual.add_child(hat)
		"spear":
			var cone := _mesh("Helmet", CylinderMesh.new(), metal)
			var cone_mesh: CylinderMesh = cone.mesh
			cone_mesh.top_radius = 0.0
			cone_mesh.bottom_radius = 0.225
			cone_mesh.height = 0.42
			cone_mesh.radial_segments = 10
			cone.position = Vector3(0.0, 1.73, 0.02)
