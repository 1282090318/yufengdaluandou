## 火焰拳炎爆的**三段特效**几何（2026-09-19 新增，纯表现）：出厂全部隐藏，由
## `unit3d.gd#_update_flame_fx()` 按 `Time.get_ticks_msec()` 的进度缩放 / 旋转 / 调亮度。三段对应三张参考图：
##   ① `FxCharge`（挂在**拳组**下 ⇒ 跟着火球走）= 蓄力爆闪：白热核心 + 三片火舌 + 四粒火星
##   ② `FxHit`（挂在 `visual` 的胸口高度）= 冲撞爆燃：火球壳 + 四片火舌 + 五粒火星
##   ③ `FxBlast`（挂在 `visual` 的脚底）= 爆炸火池：地面火盘 + 冲击环 + 一圈火墙 + 六粒火星
## ⚠️ 这里只造几何、**不写任何判定**：伤害 / 半径 / 眩晕照旧只看 `GameConfig`（不变量 I-15）。
## ⚠️ 火墙半径取 `UNIT_FLAME_BLAST_RADIUS`（真的爆炸半径）⇒ **观感与判定边界重合**，
##    不会被读成"站在火里其实已经出圈"。
static func _build_flame_fx(visual: Node3D, weapon: Node3D) -> void:
	var white_hot := Color(1.00, 0.95, 0.85)
	var flame_hot := Color(1.00, 0.42, 0.12)
	var flame_dim := Color(0.86, 0.20, 0.08)
	var spark_gold := Color(1.00, 0.80, 0.35)
	var blast_r: float = GameConfig.UNIT_FLAME_BLAST_RADIUS
	## ① 蓄力：挂点 = 右手掌上方那颗火球（与 `OrbCore` 同一个点）
	var charge := Node3D.new()
	charge.name = "FxCharge"
	charge.position = Vector3(0.40, 0.14, -0.24)
	charge.visible = false
	var core := _fx_mesh("ChargeCore", SphereMesh.new(), white_hot, true)
	var core_mesh: SphereMesh = core.mesh
	core_mesh.radius = 0.22
	core_mesh.height = 0.44
	core_mesh.radial_segments = 12
	core_mesh.rings = 6
	charge.add_child(core)
	## 五片火舌围着火球张成一把**朝上的扇**（下半圈故意留空：下面是手掌，火不该往手里烧）。
	## 三棱柱的尖（+Y）要先转到该片的方向 d 上：绕 Z 转 φ 会把 +Y 送到 (−sinφ, cosφ) ⇒ φ = atan2(−d.x, d.y)。
	for k in 5:
		var ang := -PI * 0.5 + PI * float(k) / 4.0
		var d := Vector3(sin(ang), cos(ang), 0.0)
		var tongue := _fx_mesh("ChargeTongue_%d" % k, PrismMesh.new(),
				flame_hot if k % 2 == 0 else flame_dim, false)
		(tongue.mesh as PrismMesh).size = Vector3(0.30, 0.66, 0.28)
		tongue.position = d * 0.46
		tongue.rotation = Vector3(0.0, 0.0, atan2(-d.x, d.y))
		charge.add_child(tongue)
	## 五粒火星撒在火扇外侧，跟着整团一起长大 ⇒ 读成"越烧越旺、往外蹦火星"
	for k in 5:
		var ang := -PI * 0.5 + PI * (float(k) + 0.5) / 5.0
		var d := Vector3(sin(ang), cos(ang), 0.0)
		var s := _fx_mesh("ChargeSpark_%d" % k, PrismMesh.new(), spark_gold, true)
		(s.mesh as PrismMesh).size = Vector3(0.15, 0.24, 0.15)
		s.position = d * 0.92
		s.rotation = Vector3(0.0, 0.0, atan2(-d.x, d.y))
		charge.add_child(s)
	weapon.add_child(charge)
	## ② 冲撞命中：挂点 = 胸口正前方（撞上去的那一下）
	var hit := Node3D.new()
	hit.name = "FxHit"
	hit.position = Vector3(0.0, 1.05, -0.30)
	hit.visible = false
	var shell := _fx_mesh("HitShell", SphereMesh.new(), flame_hot, true)
	var shell_mesh: SphereMesh = shell.mesh
	shell_mesh.radius = 0.55
	shell_mesh.height = 1.10
	shell_mesh.radial_segments = 12
	shell_mesh.rings = 6
	hit.add_child(shell)
	for k in 4:
		var a := TAU * float(k) / 4.0
		var dir := Vector3(cos(a), 0.0, sin(a))
		var tongue := _fx_mesh("HitTongue_%d" % k, PrismMesh.new(), flame_hot, false)
		(tongue.mesh as PrismMesh).size = Vector3(0.36, 0.58, 0.34)
		tongue.position = Vector3(dir.x * 0.36, 0.12 + (0.22 if k == 0 else 0.0), dir.z * 0.36)
		hit.add_child(tongue)
	for k in 5:
		var a := TAU * float(k) / 5.0 + 0.3
		var s := _fx_mesh("HitSpark_%d" % k, PrismMesh.new(), spark_gold, true)
		(s.mesh as PrismMesh).size = Vector3(0.13, 0.20, 0.13)
		s.position = Vector3(cos(a) * 0.74, 0.08 + (0.34 if k % 2 == 1 else 0.0), sin(a) * 0.74)
		hit.add_child(s)
	visual.add_child(hit)
	## ③ 爆炸火池：挂点 = 脚底（`unit3d.gd` 进场后会把它挂到**本体根**上，免得跟着受击晃动/呼吸浮动）
	var blast := Node3D.new()
	blast.name = "FxBlast"
	blast.position = Vector3(0.0, 0.06, 0.0)
	blast.visible = false
	var disc := _fx_mesh("BlastDisc", CylinderMesh.new(), Color(0.90, 0.26, 0.04), false)
	var disc_mesh: CylinderMesh = disc.mesh
	disc_mesh.top_radius = blast_r
	disc_mesh.bottom_radius = blast_r
	disc_mesh.height = 0.05
	disc_mesh.radial_segments = 24
	blast.add_child(disc)
	var ring := _fx_mesh("BlastRing", TorusMesh.new(), Color(1.00, 0.52, 0.16), true)
	var ring_mesh: TorusMesh = ring.mesh
	ring_mesh.inner_radius = blast_r - 0.18
	ring_mesh.outer_radius = blast_r + 0.10
	ring_mesh.rings = 24
	ring_mesh.ring_segments = 8
	ring.position = Vector3(0.0, 0.10, 0.0)
	blast.add_child(ring)
	for k in 8:
		var a := TAU * float(k) / 8.0
		var dir := Vector3(cos(a), 0.0, sin(a))
		var wall := _fx_mesh("BlastFlame_%d" % k, PrismMesh.new(),
				flame_hot if k % 2 == 0 else flame_dim, false)
		(wall.mesh as PrismMesh).size = Vector3(0.85, 2.30, 0.80)
		## 火舌沿**切线**排（脊朝上、长边绕圈）⇒ 八片连起来读成"一圈火墙"，而不是八个孤立的火苗
		wall.rotation = Vector3(0.0, a + PI * 0.5, 0.0)
		wall.position = Vector3(dir.x * (blast_r - 0.8), 1.15, dir.z * (blast_r - 0.8))
		blast.add_child(wall)
	for k in 6:
		var a := TAU * float(k) / 6.0 + 0.4
		var s := _fx_mesh("BlastSpark_%d" % k, PrismMesh.new(), spark_gold, true)
		(s.mesh as PrismMesh).size = Vector3(0.14, 0.24, 0.14)
		s.position = Vector3(cos(a) * (blast_r + 0.2), 0.30, sin(a) * (blast_r + 0.2))
		blast.add_child(s)
	visual.add_child(blast)

## 沙虫**潜地时的位置提示**（纯表现，2026-09-19 用户："潜地时应有特效显示其位置（加一些沙尘，
## 总体形状类似半球）"）：一个**沙色半球**（`SphereMesh.is_hemisphere`，双面可见）+ 地面一圈沙环
## + 六团扬尘。出厂隐藏，由 `unit3d.gd#_process()` 在"潜入地下"时显示并做轻微呼吸。
## ⚠️ 它会被 `_ready()` **reparent 到本体根**上 ⇒ 不跟着模型一起沉下去（否则提示也埋进地里了）。
static func _build_burrow_fx(visual: Node3D) -> void:
	var sand := Color(0.82, 0.70, 0.48)
	var sand_dark := Color(0.62, 0.50, 0.32)
	var root := Node3D.new()
	root.name = "FxBurrow"
	root.visible = false
	var dome := _fx_mesh("DustDome", SphereMesh.new(), sand, false)
	var dome_mesh: SphereMesh = dome.mesh
	dome_mesh.radius = 1.80
	## ⚠️ 2026-09-19 用户："沙尘特效的高度太高，整矮一点，变为原来的三分之一" ⇒ **只压高度**
	##（XZ 半径不变 ⇒ 从半球变成一片贴地的扁沙堆）：height 3.60 → **1.20**（半球可见高度 = height/2）。
	dome_mesh.height = 1.20
	dome_mesh.is_hemisphere = true          ## 只要上半 ⇒ 扁半球
	dome_mesh.radial_segments = 16
	dome_mesh.rings = 8
	var dome_mat := dome.material_override as StandardMaterial3D
	dome_mat.cull_mode = BaseMaterial3D.CULL_DISABLED    ## 俯视/贴地看都读得出"一堆沙"
	dome_mat.albedo_color.a = 0.34
	root.add_child(dome)
	## ⚠️ 2026-09-19 用户："边缘与环境做渐变（即逐渐变透明）" ⇒ 再套一层**更淡、略大**的外壳：
	## 两层叠加后边缘比中心淡，读起来就是羽化的沙堆（不写 shader，与项目既有的做法一致）。
	var outer := _fx_mesh("DustHaze", SphereMesh.new(), sand, false)
	var outer_mesh: SphereMesh = outer.mesh
	outer_mesh.radius = 2.35
	outer_mesh.height = 1.10
	outer_mesh.is_hemisphere = true
	outer_mesh.radial_segments = 16
	outer_mesh.rings = 8
	var outer_mat := outer.material_override as StandardMaterial3D
	outer_mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	outer_mat.albedo_color.a = 0.14      ## 只要一点点 ⇒ 只负责"边缘不是硬边"
	root.add_child(outer)
	var ring := _fx_mesh("DustRing", CylinderMesh.new(), sand_dark, false)
	var ring_mesh: CylinderMesh = ring.mesh
	ring_mesh.top_radius = 2.10
	ring_mesh.bottom_radius = 2.45
	ring_mesh.height = 0.10
	ring_mesh.radial_segments = 20
	ring.position = Vector3(0.0, 0.06, 0.0)
	(ring.material_override as StandardMaterial3D).albedo_color.a = 0.55
	root.add_child(ring)
	for k in 6:
		var a := TAU * float(k) / 6.0 + 0.3
		var puff := _fx_mesh("DustPuff_%d" % k, SphereMesh.new(), sand, false)
		var puff_mesh: SphereMesh = puff.mesh
		puff_mesh.radius = 0.44
		puff_mesh.height = 0.88
		puff_mesh.radial_segments = 10
		puff_mesh.rings = 5
		(puff.material_override as StandardMaterial3D).albedo_color.a = 0.36
		puff.position = Vector3(cos(a) * 1.60, 0.45 + 0.24 * float(k % 3), sin(a) * 1.60)
		root.add_child(puff)
	visual.add_child(root)

## 沙虫**浮出地面时的"震地"特效**（纯表现，2026-09-19 用户："沙柱爆开（更重的版本）"）：
## 一次性爆发（时长/高度/外散距离见 `unit3d.gd#BURROW_FX_*`），由 `unit3d.gd#_update_burst_fx()` 驱动：
##   · `BurstDome` —— 向上扬起的沙浪（扁半球，**半径 = 眩晕判定半径 4 m** ⇒ 观感与判定边界重合）；
##   · `BurstPillar` —— **从地里窜起来的沙柱**（锥体；节点原点在地面 ⇒ 播放时压 `scale.y` 就是"往上长"）；
##   · `BurstRing` —— 向外扩散的地面沙环（**网格半径就是 1 m** ⇒ 播放时 `scale` 直接读作米）；
##   · `BurstPuff_0..5` —— 六团向外上方飞散的沙团（位置存**单位方向**，播放时乘外散距离）。
## ⚠️ 半径一律读 `GameConfig.UNIT_SANDWORM_SURFACE_STUN_RADIUS`（与炎爆火池取 `UNIT_FLAME_BLAST_RADIUS`
## 同一条规矩）；⚠️ 出厂隐藏；⚠️ 它会被 `Unit3D.setup()` **reparent 到本体根**（与 `FxBurrow` 同理）
## ⇒ 不跟着模型的呼吸浮动 / 潜地下沉一起动。
static func _build_burst_fx(visual: Node3D) -> void:
	var radius: float = GameConfig.UNIT_SANDWORM_SURFACE_STUN_RADIUS
	var sand := Color(0.86, 0.73, 0.50)
	var sand_dark := Color(0.60, 0.48, 0.30)
	var root := Node3D.new()
	root.name = "FxBurst"
	root.visible = false
	## ① 沙浪：扁半球（可见高度 = height/2 ⇒ 2.40 → 1.20 m，比潜地沙尘那 0.60 高一倍，读起来是"炸开"）
	var dome := _fx_mesh("BurstDome", SphereMesh.new(), sand, false)
	var dome_mesh: SphereMesh = dome.mesh
	dome_mesh.radius = radius
	dome_mesh.height = 2.40
	dome_mesh.is_hemisphere = true
	dome_mesh.radial_segments = 20
	dome_mesh.rings = 8
	var dome_mat := dome.material_override as StandardMaterial3D
	dome_mat.cull_mode = BaseMaterial3D.CULL_DISABLED      ## 俯视/贴地看都读得出"一堆沙"
	dome_mat.albedo_color.a = 0.55                         ## 比潜地沙尘（0.34）实一档：这是"炸开"不是"提示"
	root.add_child(dome)
	## ② 沙柱：从地里窜起来的一根锥（**节点原点钉在地面**，网格往上抬 height/2 ⇒ 压 `scale.y` = 往上长）
	var pillar := Node3D.new()
	pillar.name = "BurstPillar"
	var pillar_mesh := _fx_mesh("BurstPillarBody", CylinderMesh.new(), sand, false)
	var pillar_cyl: CylinderMesh = pillar_mesh.mesh
	pillar_cyl.top_radius = 0.28
	pillar_cyl.bottom_radius = 1.05
	pillar_cyl.height = 2.60
	pillar_cyl.radial_segments = 16
	pillar_cyl.rings = 0
	(pillar_mesh.material_override as StandardMaterial3D).albedo_color.a = 0.62
	pillar_mesh.position = Vector3(0.0, 1.30, 0.0)
	pillar.add_child(pillar_mesh)
	root.add_child(pillar)
	## ② 地面沙环：网格半径 1 m，播放时按"目标半径（米）"缩放 ⇒ 最大正好撑到判定半径
	var ring := _fx_mesh("BurstRing", CylinderMesh.new(), sand_dark, false)
	var ring_mesh: CylinderMesh = ring.mesh
	ring_mesh.top_radius = 1.0
	ring_mesh.bottom_radius = 1.0
	ring_mesh.height = 0.16
	ring_mesh.radial_segments = 28
	(ring.material_override as StandardMaterial3D).albedo_color.a = 0.60
	ring.position = Vector3(0.0, 0.09, 0.0)
	root.add_child(ring)
	## ③ 六团飞沙：**只存单位方向**（长度 1），播放时乘 `半径 × BURROW_FX_BURST_SPREAD` 再叠上扬
	for k in 6:
		var a := TAU * float(k) / 6.0 + 0.35
		var puff := _fx_mesh("BurstPuff_%d" % k, SphereMesh.new(), sand, false)
		var puff_mesh: SphereMesh = puff.mesh
		puff_mesh.radius = 0.55
		puff_mesh.height = 1.10
		puff_mesh.radial_segments = 10
		puff_mesh.rings = 5
		(puff.material_override as StandardMaterial3D).albedo_color.a = 0.40
		puff.position = Vector3(cos(a), 0.0, sin(a))
		root.add_child(puff)
	visual.add_child(root)

## 玉面手雷王**死亡自爆**的观感（纯表现，2026-09-25 第二轮新增）：半径 = `GameConfig.UNIT_GRENADE_BLAST_RADIUS`
## （4 m，与判定同值 ⇒ 观感与判定边界重合），**出厂即隐藏**。
##   · `BlastCore`  —— 爆心那颗火球（挂在 +0.55 m，读起来是"从身体里炸开"）；
##   · `BlastRing`  —— 贴地的一层火盘（网格半径就是判定半径 4 m ⇒ 播放时 `scale` 直接读作米，
##                    与沙虫的 `BurstRing` 同一套约定）；
##   · `BlastEdge`  —— 火盘外缘一圈深色描边，把"炸到哪儿为止"这条线勾硬；
##   · `BlastFlame_0..3` —— 四片短火舌（高低交替、绕 Y 各偏 0.35 rad，破掉"四个正交方块"的机械感）。
##
## ⚠️ **登记点 = 根节点名 `FxHit`**，挂在 `visual` 下 —— 这是本函数唯一"看起来多余"的一行，但它不能改名：
##   `unit3d.gd#_ready()` 用 `_visual.get_node_or_null("FxHit")` 取它，而 `warmup_show_all_fx()`
##   只显示它认识的那五个根（`FxCharge` / `FxHit` / `FxBlast` / `FxBurrow` / `FxBurst`）——
##   名字一旦不一样，这套"透明 + 自发光"的几何就**永远不会被预热画到**
##   （`main.gd#_prewarm_unit_models()` 在生产环境里就画这一帧）。
## ⚠️ **它不会在别的时候冒出来**：`_fx_hit` 的显隐写在 `unit3d.gd#_update_flame_fx()` 里，而那支函数
##   **第一行就是 `if _fx_charge == null: return`** —— 手雷王的 `weapon`（`Arms`）下没有 `FxCharge`
##   ⇒ 该函数对它直接返回，`_fx_hit` 从头到尾没人碰 ⇒ 恒为全场隐藏，
##   直到它自己被 `_die()` 那侧（自爆实现方）显示为止。
##    ⚠️ **给自爆实现方的接口**：显示 / 隐藏请切 `_fx_hit.visible`（或照火焰拳的 `_fx_hit_until_ms` 那套播），
##    **不要改这个节点名** —— 改名 = 悄悄丢掉预热（不报错、只是第一次自爆卡一帧）。
##    ⚠️ 火焰拳的 `FxBlast` 会被 `_ready()` **reparent 到本体根**上（免得跟着呼吸浮动 / 眩晕摇晃）；
##    本节点**留在 `visual` 下**、局部变换是**恒等** ⇒ 世界坐标逐位相同（自爆是以**自身**为中心的），
##    所以不必跟着一起 reparent；反过来，如果哪天真要把它当"跟着晃动"的挂点，再改成 reparent 即可。
## ⚠️ **另一件必须由自爆实现方保证的事**：`_fx_hit` 只在 `_process()` 里被改写，而
##    `unit3d.gd#_die()` 会给本体 `set_process(false)` ⇒ 自爆若要在**死亡之后**播完这段火，
##    得让 `_die()` 那条路晚一点 `queue_free()`（或自己接管这几帧），否则刚点亮就随本体一起被释放。
## ⚠️ 形状刻意与火焰拳的 `FxBlast`（6 m 火盘 + 八片高火墙）**不同**：那是一个"大火池"，
##   这里是一个**小个子炸开的火球**，两件 AOE 特效不会在场上被认成同一招（理由见常量段）。
static func _build_grenadier_blast_fx(visual: Node3D) -> void:
	var blast_r: float = GameConfig.UNIT_GRENADE_BLAST_RADIUS
	var blast_hot := Color(1.00, 0.62, 0.20)
	var blast_dim := Color(0.90, 0.26, 0.06)
	var blast_soot := Color(0.28, 0.14, 0.05)
	var root := Node3D.new()
	root.name = "FxHit"
	root.visible = false
	## ① 爆心：一颗火球（`additive = true` ⇒ 与地面火盘叠在一起会更亮，读作"爆炸中心"）
	var core := _fx_mesh("BlastCore", SphereMesh.new(), blast_hot, true)
	var core_mesh: SphereMesh = core.mesh
	core_mesh.radius = GRENADIER_BLAST_CORE_R
	core_mesh.height = GRENADIER_BLAST_CORE_R * 2.0
	core_mesh.radial_segments = 12
	core_mesh.rings = 6
	core.position = Vector3(0.0, 0.55, 0.0)
	root.add_child(core)
	## ② 地面火盘：**网格半径 = 判定半径**（不给缩放留任何解释空间），外侧一圈亮环勾出"炸到哪儿为止"
	var disc := _fx_mesh("BlastRing", CylinderMesh.new(), blast_dim, false)
	var disc_mesh: CylinderMesh = disc.mesh
	disc_mesh.top_radius = blast_r
	disc_mesh.bottom_radius = blast_r
	disc_mesh.height = GRENADIER_BLAST_RING_H
	disc_mesh.radial_segments = 24
	disc.position = Vector3(0.0, 0.05, 0.0)
	root.add_child(disc)
	var edge := _fx_mesh("BlastEdge", TorusMesh.new(), blast_soot, false)
	var edge_mesh: TorusMesh = edge.mesh
	edge_mesh.inner_radius = blast_r - 0.16
	edge_mesh.outer_radius = blast_r + 0.10
	edge_mesh.rings = 24
	edge_mesh.ring_segments = 8
	edge.position = Vector3(0.0, 0.11, 0.0)
	root.add_child(edge)
	## ③ 四片短火舌：高低交替、绕 Y 各偏一点 ⇒ 不是四个正交的方块
	for k in 4:
		var a := TAU * float(k) / 4.0 + 0.35
		var dir := Vector3(cos(a), 0.0, sin(a))
		var flame := _fx_mesh("BlastFlame_%d" % k, PrismMesh.new(), blast_hot, false)
		(flame.mesh as PrismMesh).size = Vector3(0.62, 1.10 if k % 2 == 0 else 0.78, 0.58)
		flame.rotation = Vector3(0.0, a, 0.0)
		flame.position = Vector3(dir.x * 1.05, 0.55, dir.z * 1.05)
		root.add_child(flame)
	visual.add_child(root)

## 特效件（2026-09-19 新增）：在 `_mesh()` 的结果上改成**透明 + 自发光更强**。
##   · `additive = true` 的件（火心 / 冲击环 / 火星这类"发光体"）走加色混合，叠在一起会更亮；
##   · 其余（火舌 / 火墙 / 火盘）走普通混合，形状更实、不会被背景冲淡。
## 亮度与淡出由 `unit3d.gd#_glow_fx()` 改 `emission_energy_multiplier` 与 `albedo_color.a` 驱动 ——
## 因此这里不必给每个件另存一份原色：自发光色已由 `_mesh()` 按同一颜色写好，改倍率就够。
## ⚠️ 这里**不设每个件自己的 `visible`**：显隐一律交给三个**整段**挂点（`_build_flame_fx()` 里出厂即隐藏，
## `unit3d.gd#_show_fx()` 每帧只切那一个布尔）。2026-09-19 踩过的坑：件级 `visible = false` + 只开父级
## ⇒ 父级"可见"但整段一个件都不渲染，看上去像特效完全没触发。
static func _soft_ball(node_name: String, radius: float, color: Color) -> Node3D:
	var root := Node3D.new()
	root.name = node_name
	var inner_mesh := SphereMesh.new()
	inner_mesh.radius = radius
	inner_mesh.height = radius * 2.0
	inner_mesh.radial_segments = 16
	inner_mesh.rings = 8
	var core := _fx_mesh("Core", inner_mesh, color, false)
	var core_mat := core.material_override as StandardMaterial3D
	core_mat.albedo_color.a = 0.92
	root.add_child(core)
	var haze_mesh := SphereMesh.new()
	haze_mesh.radius = radius * 1.9
	haze_mesh.height = radius * 3.8
	haze_mesh.radial_segments = 12
	haze_mesh.rings = 6
	var haze := _fx_mesh("Haze", haze_mesh, color, true)
	var haze_mat := haze.material_override as StandardMaterial3D
	haze_mat.albedo_color.a = 0.22
	root.add_child(haze)
	return root


static func _fx_mesh(node_name: String, mesh: Mesh, color: Color, additive: bool) -> MeshInstance3D:
	var mi := _mesh(node_name, mesh, color)
	var mat := mi.material_override as StandardMaterial3D
	mat.albedo_color = Color(color.r * 0.45, color.g * 0.45, color.b * 0.45, 1.0)
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	if additive:
		mat.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	mat.emission_energy_multiplier = 2.0
	return mi

## 扇子兵的**实心扇面**（2026-09-24 R2）：手搓一个平面扇形网格 ——
## 本体的 −Z 是扇面的角平分线，从原点张开 ±`FAN_HALF_ARC_DEG`，半径 `FAN_RADIUS`，厚 `FAN_THICKNESS`。
## 正反两面都建了三角形（各自带朝下的法线），所以扇面**双面可见**、不会被背面剔除吃掉。
## ⚠️ 这里用 `ArrayMesh` 是必要的：Godot 的基础网格里没有"扇形平板"，
## 而用"横条拼扇形"会糊成一个圆盘（就是 R2 要修的那个症状）。
static func _fan_face_mesh() -> ArrayMesh:
	var arcs := 16                                   ## 弧边分段数：越大弧越圆滑
	var rib_step := deg_to_rad(FAN_HALF_ARC_DEG * 2.0 / float(arcs))
	# 先在水平面里生成扇形顶点：(−sinθ, 0, −cosθ)·r —— θ 从 −45° 到 +45°，正前方是 −Z
	var rim: Array[Vector3] = []
	for k in arcs + 1:
		var theta := -deg_to_rad(FAN_HALF_ARC_DEG) + rib_step * float(k)
		rim.append(Vector3(-sin(theta), 0.0, -cos(theta)) * FAN_RADIUS)
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for face in 2:
		var down := face == 0                        ## 正面朝下、背面朝上
		var normal := Vector3(0.0, -1.0 if down else 1.0, 0.0)
		var y := -FAN_THICKNESS * 0.5 if down else FAN_THICKNESS * 0.5
		var centre := Vector3(0.0, y, 0.0)
		for k in arcs:
			var a := rim[k]
			var b := rim[k + 1]
			a.y = y
			b.y = y
			## 两面的绕序各自反过来，保证正面（down 那面）朝 −Y、背面朝 +Y
			var tri := [centre, a, b] if down else [centre, b, a]
			for v in tri:
				st.set_normal(normal)
				st.add_vertex(v)
	return st.commit()

static func _mesh(node_name: String, mesh: Mesh, color: Color) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.name = node_name
	mi.mesh = mesh
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	# 轻微自发光：暗色场景下保证兵种/队伍颜色可辨认（见 docs/bible/00_world.md#4-美术调性）
	mat.emission_enabled = true
	mat.emission = color
	mat.emission_energy_multiplier = 0.28
	mi.material_override = mat
	return mi

## 内区宽度（px）：血条的填充最多分这么多档，`unit3d.gd` 也用它判断"要不要重建贴图"（唯一住处）。
## ⚠️ **2026-09-25 由 30 提到 46**（随"血条放大到 2 倍"一起，见 `unit3d.gd#BAR_PIXEL_SIZE`）：
## 贴图总宽 48 px、高 9 px，世界尺寸 48 × 0.015 = 0.72 × 0.135 m。
## 档位从 30 变 46 ⇒ 填充更细；跨档重建的次数上限也跟着从 30 变 46（一次受伤最多 46 次，仍可忽略）。
const HEALTH_BAR_INNER_PX := 46
static var _health_bars: Dictionary = {}

## 程序化血条贴图（2026-09-19 重做）：**底槽 + 填充画在同一张图里**。
## ⚠️ 为什么不做成"两层 sprite 叠加"（我试过，两个坑都踩了）：
##   ① `material_override` 会让 sprite 自己的贴图失效 —— 老代码的血条其实一直在渲染成一块**纯色方块**
##      （用户"无法看出单位还剩多少血量"的真因，不是尺寸问题）；
##   ② 两层之间还会互相压：实测实例的 `render_priority` 不生效，底槽（alpha 0.8）会盖在填充上，
##      把队伍色整整压暗一半。
## 一张图绕开全部层级/混合的坑，代价只是**填充宽度按内区像素步进**（30 档，肉眼无差）。
##   `ratio` 0~1 = 剩余血量比例；`fill_color` 由调用方给 ⇒ 颜色不在这里写死，
##   一律取 `GameConfig.team_color()`，即 `00_world.md#4.3` 的**世界**队伍色
##   （⚠️ **不是** `05_ui_hud.md#1` 规则 3 那组 HUD 调色板，两套值不同，见 `99_decisions.md` 2026-09-19 条目）。
static func health_bar_texture(ratio: float, fill_color: Color) -> ImageTexture:
	var key := fill_color.to_html(false)
	if not _health_bars.has(key):
		var levels: Array = []
		for px in range(HEALTH_BAR_INNER_PX + 1):
			levels.append(_bake_health_bar(px, fill_color))
		_health_bars[key] = levels
	var fill_px := int(round(clampf(ratio, 0.0, 1.0) * float(HEALTH_BAR_INNER_PX)))
	return (_health_bars[key] as Array)[fill_px]

static func _bake_health_bar(fill_px: int, fill_color: Color) -> ImageTexture:
	const FRAME_PX := 1
	const HEIGHT_PX := 9
	var width := HEALTH_BAR_INNER_PX + FRAME_PX * 2
	var img := Image.create(width, HEIGHT_PX, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.05, 0.05, 0.06, 0.85))
	for x in range(FRAME_PX, width - FRAME_PX):
		for y in range(FRAME_PX, HEIGHT_PX - FRAME_PX):
			if x < FRAME_PX + fill_px:
				img.set_pixel(x, y, fill_color)
			else:
				img.set_pixel(x, y, Color(0.17, 0.17, 0.20, 0.80))
	return ImageTexture.create_from_image(img)

## 魔法护盾条：比血条矮、青白框、中间留一条缝，读起来是一根管子而不是第二根血条。
static func shield_bar_texture(ratio: float) -> ImageTexture:
	const FRAME_PX := 1
	const HEIGHT_PX := 7
	var width := HEALTH_BAR_INNER_PX + FRAME_PX * 2
	var fill_px := int(round(clampf(ratio, 0.0, 1.0) * float(HEALTH_BAR_INNER_PX)))
	var img := Image.create(width, HEIGHT_PX, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.15, 0.55, 0.72, 0.95))
	var fill := Color(0.55, 1.0, 1.0, 1.0)
	var empty := Color(0.05, 0.12, 0.16, 0.9)
	for x in range(FRAME_PX, width - FRAME_PX):
		for y in range(FRAME_PX, HEIGHT_PX - FRAME_PX):
			if y == HEIGHT_PX / 2:
				img.set_pixel(x, y, Color(0.75, 1.0, 1.0, 0.35))
			elif x < FRAME_PX + fill_px:
				img.set_pixel(x, y, fill)
			else:
				img.set_pixel(x, y, empty)
	return ImageTexture.create_from_image(img)
