			weapon = Node3D.new()
			weapon.name = "CrystalPivot"
			weapon.position = Vector3(0.0, PILLAR_CORE_Y, 0.0)
			var core_top := _mesh("CrystalTop", CylinderMesh.new(), PILLAR_CORE_COLOR)
			var core_top_mesh: CylinderMesh = core_top.mesh
			core_top_mesh.top_radius = 0.0
			core_top_mesh.bottom_radius = PILLAR_CORE_R
			core_top_mesh.height = PILLAR_CORE_R * 1.7
			core_top_mesh.radial_segments = 4
			core_top.position = Vector3(0.0, PILLAR_CORE_R * 0.85, 0.0)
			(core_top.material_override as StandardMaterial3D).emission_energy_multiplier = PILLAR_CORE_GLOW
			weapon.add_child(core_top)
			var core_bottom := _mesh("CrystalBottom", CylinderMesh.new(), PILLAR_CORE_COLOR)
			var core_bottom_mesh: CylinderMesh = core_bottom.mesh
			core_bottom_mesh.top_radius = PILLAR_CORE_R
			core_bottom_mesh.bottom_radius = 0.0
			core_bottom_mesh.height = PILLAR_CORE_R * 1.7
			core_bottom_mesh.radial_segments = 4
			## ⚠️ **不要给它加 `rotation`**：`CylinderMesh` 的 `top_radius` / `bottom_radius` 就是 +Y / −Y 两端的
			## 半径，所以"上口带半径、下口收到 0"本身就是**尖朝下**的那半颗。
			## 实机截图抓到过一版画反的：给它加了 `rotation.x = PI` ⇒ 两颗都朝上、叠成一个向上的三角。
			core_bottom.position = Vector3(0.0, -PILLAR_CORE_R * 0.85, 0.0)
			(core_bottom.material_override as StandardMaterial3D).emission_energy_multiplier = PILLAR_CORE_GLOW
			weapon.add_child(core_bottom)
			visual.add_child(weapon)

		"doom_eye":
			## 湮灭之瞳（2026-09-27 第十轮新增 / **第十一轮重做成"一只眼"**）：造型与全部尺寸见上面
			## `DOOM_*` 段的口径说明。⚠️ 它属于 `NO_HUMANOID_TYPES` ⇒ 骨架一件都不建 ——
			## **眼球就是它自己的 `Body`**（队伍色的载体 + 受击闪白 / 心灵腐化换边都走既有那两条路）。
			## 拼装顺序：贴地光环 → 下眼皮 + 上眼皮 → 眼球 → 瞳孔 / 虹膜 / 光点（`GazePivot` 组）。
			## ① 上下眼皮：**与眼球同心的半球壳**（`SphereMesh.is_hemisphere`，半径略大于眼球）——
			##    半球的边缘正好是一圈**纬线** ⇒ 那就是"眼睑的边"，两只一合中间自然是一道杏仁形开口。
			##    ⚠️ **不要用薄盒子**：直板会穿进球体（第十一轮先用盒子写，渲染出来是"红球上插了两片板"）。
			##    ⚠️ **也不要用扁椭球**：椭球的上下两端收成**一个点**、不是圆边 ⇒ 看着像给球戴了顶帽子
			##    （第二版就是这么废的，两张预览图都留在 `.preview/`）。
			##    ⚠️ 两只各**绕自身 X 轴再倾 `DOOM_LID_PITCH`**（上睑向后仰、下睑向前压）⇒ 开口偏向"上看"那一侧。
			##    ⚠️ **上眼皮也用暗金属**（试过给它吃队伍色：它和队伍色的眼球同色 ⇒ 远看整只糊成一个色球，
			##    眼形当场没了）。队伍色由**眼球本身**（大面积露着）+ 虹膜 + 贴地光环一起承担。
			##    ⚠️ **用环面（`TorusMesh`）而不是半球壳**：`SphereMesh.is_hemisphere` 的半球**带一个平底盖**，
			##    那个盖正好从球心横切过去 ⇒ 渲染成锯齿（第三、四版都栽在这上面）。环面躺在 XZ 平面、
			##    内径比眼球大 ⇒ **几何上不可能与球面相交**，边缘天然干净 ✓（试了四版才定下来）。
			for lid_row in [["Upper", 1.0, DOOM_LID_TUBE], ["Lower", -1.0, DOOM_LID_TUBE * 0.8]]:
				var lid_name := String(lid_row[0])
				var lid_sign := float(lid_row[1])
				var lid_tube := float(lid_row[2])
				var lid_dy: float = DOOM_LID_DY if lid_sign > 0.0 else DOOM_LID_DY * 1.04
				## 环所在的**纬度**：它必须与眼球在该高度的截面半径对齐（否则要么穿进球里、要么飘在外面）
				var cross := sqrt(maxf(DOOM_CORE_R * DOOM_CORE_R - lid_dy * lid_dy, 0.01))
