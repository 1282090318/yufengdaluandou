## 每种兵的模型只造一次。之后摆的人复制节点、共用网格，材质各自一份（受击闪白不能串）。
static func build(type_id: String, team: int) -> Dictionary:
	if not _model_templates.has(type_id):
		var baked: Dictionary = _build_fresh(type_id, 0)
		var root: Node3D = baked["visual"]
		var weapon_path := ""
		var shield_path := ""
		var weapon_raw = baked["weapon"]
		var shield_raw = baked["shield"]
		if weapon_raw != null:
			weapon_path = str(root.get_path_to(weapon_raw))
		if shield_raw != null:
			shield_path = str(root.get_path_to(shield_raw))
		_model_templates[type_id] = {
			"visual": root,
			"weapon_path": weapon_path,
			"shield_path": shield_path,
		}
	var src: Dictionary = _model_templates[type_id]
	var template: Node3D = src["visual"]
	var visual := template.duplicate(0) as Node3D
	_own_model_materials(visual)
	if team != 0:
		_recolor_team_materials(visual, 0, team)
	_own_bow_string_meshes(visual)
	var weapon: Node3D = null
	var shield: Node3D = null
	var weapon_path := String(src["weapon_path"])
	var shield_path := String(src["shield_path"])
	if weapon_path != "":
		weapon = visual.get_node(NodePath(weapon_path)) as Node3D
	if shield_path != "":
		shield = visual.get_node(NodePath(shield_path)) as Node3D
	return {"visual": visual, "weapon": weapon, "shield": shield}

static func _own_model_materials(root: Node) -> void:
	for node in root.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		if mi == null:
			continue
		if mi.material_override != null:
			mi.material_override = mi.material_override.duplicate()
		if mi.mesh == null:
			continue
		for surface_i in mi.mesh.get_surface_count():
			var mat := mi.get_surface_override_material(surface_i)
			if mat != null:
				mi.set_surface_override_material(surface_i, mat.duplicate())

static func _recolor_team_materials(root: Node, from_team: int, to_team: int) -> void:
	var src := GameConfig.team_color(from_team)
	var dst := GameConfig.team_color(to_team)
	var src_light := src.lightened(0.55)
	var dst_light := dst.lightened(0.55)
	for node in root.find_children("*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		if mi == null:
			continue
		_paint_team_color(mi.material_override as StandardMaterial3D, src, dst, src_light, dst_light)
		if mi.mesh == null:
			continue
		for surface_i in mi.mesh.get_surface_count():
			_paint_team_color(mi.get_surface_override_material(surface_i) as StandardMaterial3D, src, dst, src_light, dst_light)

static func _paint_team_color(mat: StandardMaterial3D, src: Color, dst: Color, src_light: Color, dst_light: Color) -> void:
	if mat == null:
		return
	if _same_rgb(mat.albedo_color, src):
		mat.albedo_color = Color(dst.r, dst.g, dst.b, mat.albedo_color.a)
		if _same_rgb(mat.emission, src):
			mat.emission = Color(dst.r, dst.g, dst.b, mat.emission.a)
	elif _same_rgb(mat.albedo_color, src_light):
		mat.albedo_color = Color(dst_light.r, dst_light.g, dst_light.b, mat.albedo_color.a)
		if _same_rgb(mat.emission, src_light):
			mat.emission = Color(dst_light.r, dst_light.g, dst_light.b, mat.emission.a)

static func _same_rgb(a: Color, b: Color) -> bool:
	return is_equal_approx(a.r, b.r) and is_equal_approx(a.g, b.g) and is_equal_approx(a.b, b.b)

## 弓臂梢在弓组件局部坐标里的位置（2026-11-02 新增，为"两半弓弦"提供弦端坐标）。
## 弓臂是一根 `CylinderMesh`：网格沿自身 **+Y** 长出去，所以梢 = 枢轴位置 + 姿态 × (0, ±半长, 0)；
## 名字以 `_upper` 结尾的那根取 **+半长**、`_lower` 取 −半长（与各支自己算 `up` 的写法同号）。
static func _limb_tip(bow: Node3D, limb_name: String) -> Vector3:
	var limb := bow.get_node_or_null(limb_name) as MeshInstance3D
	if limb == null or not (limb.mesh is CylinderMesh):
		return Vector3.ZERO
	var half_len: float = (limb.mesh as CylinderMesh).height * 0.5
	var up := 1.0 if limb_name.ends_with("upper") else -1.0
	return limb.position + limb.transform.basis * Vector3(0.0, half_len * up, 0.0)

## 两半弓弦（2026-11-02 新增，用户："拉弓的时候弦不要脱离弓"）。
## 每半 = 枢轴（`BowStringHalf_<end>`，位置**钉在弓臂梢**上）+ 弦杆（`BowStringBar_<end>`，沿枢轴的 +Z 长出去）。
## 原先两种弓手都是**一整根直弦**，拉弓时整根沿 +Z 平移 ⇒ 两头会离开弓梢 0.2 m（用户看到的"弦脱离弓"）。
## 拆成两半之后弦端永远在弓梢上，弦心由 `unit3d.gd#_pose_bow_string_to_hand()` 每帧追着**拉弦手**走。
## ⚠️ 弦杆名字必须以 `BowStringBar_` 开头 —— `_own_bow_string_meshes()` 靠它给每个单位复制一份网格
## （网格是模板共用的，不复制的话所有弓手会一起变长）。
static func _build_bow_string(parent: Node3D, ends: Array, tips: Array[Vector3],
		vertex: Vector3, thickness: float, color: Color) -> void:
	for i in ends.size():
		var end := String(ends[i])
		var tip: Vector3 = tips[i]
		var span := vertex - tip
		var span_len := maxf(span.length(), 0.01)
		var half := Node3D.new()
		half.name = "BowStringHalf_%s" % end
		half.position = tip
		## 与弩车半弦同一套"+Z 对上这一段"的朝向（俯仰 `asin` + 偏航 `atan2`）
		half.rotation = Vector3(-asin(clampf(span.y / span_len, -1.0, 1.0)),
				atan2(span.x, span.z), 0.0)
		var bar := _mesh("BowStringBar_%s" % end, BoxMesh.new(), color)
		(bar.mesh as BoxMesh).size = Vector3(thickness, thickness, span_len)
		bar.position = Vector3(0.0, 0.0, span_len * 0.5)
		half.add_child(bar)
		parent.add_child(half)

## 弩车弦杆每帧改长度。共用网格会让所有弩车一起拉弦。
static func _own_bow_string_meshes(root: Node) -> void:
	for node in root.find_children("BowStringBar_*", "MeshInstance3D", true, false):
		var mi := node as MeshInstance3D
		if mi != null and mi.mesh != null:
			mi.mesh = mi.mesh.duplicate()

static func _build_fresh(type_id: String, team: int) -> Dictionary:
	var base: Color = GameConfig.team_color(team)
	var skin := Color(0.82, 0.72, 0.60)
	var metal := Color(0.62, 0.66, 0.72)
	var wood := Color(0.42, 0.28, 0.16)
	var cloth := Color(0.33, 0.30, 0.28)      ## 兜帽 / 箭袋：低饱和布料色，不抢队伍色
	var build_style: Dictionary = SILHOUETTE.get(type_id, SILHOUETTE["sword"])

	var visual := Node3D.new()
	visual.name = "Visual"

	## 骑乘（2026-09-25 第三条）：轻骑兵（矛）**骑马** —— 马直接长在 `Visual` 下，
	## 人形 / 头盔 / 武器整体挂到 `Rider` 上并抬高 `MOUNT_RIDER_LIFT`。
	## ⚠️ 为什么要单独一个 `Rider` 节点、而不是给每个部件挨个加偏移：
	##   `_headgear()` 与 12 个 `match` 分支里的坐标全是**按"脚在 y = 0"写死**的，
	##   逐个改偏移等于把整套人形坐标系重算一遍；挂一个父节点抬高，那些坐标**一个字都不用动**。
	## ⚠️ 副作用（已处理）：`Body` 从此**不再是 `Visual` 的直接子节点** ⇒
	##   `unit3d.gd` 取躯干改成递归查找（否则受击闪白对它**静默失效**）。
	var rider_lift_y := rider_lift(type_id)
	var rider: Node3D = null
	if rider_lift_y > 0.0:
		rider = Node3D.new()
		rider.name = "Rider"
		rider.position = Vector3(0.0, rider_lift_y, 0.0)
		visual.add_child(rider)
		_build_mount(visual, base, metal)
	## 人形的挂点：骑乘兵种挂到 `Rider`（跟着抬高），其余兵种仍是 `Visual` 本身（行为逐位不变）。
	var humanoid: Node3D = rider if rider != null else visual

	## 载具（2026-09-24 用户："弩车投石车先把人给去掉"）——这两台**不建人形**：
	## 躯干 / 头 / 鼻尖 / 头盔全部跳过，只留机械。⚠️ `SILHOUETTE` 里那两行仍保留（`unit3d.gd` 的
	## 碰撞胶囊、血条挂点都不看它），去掉的只是"看得见的人"。
	if NO_HUMANOID_TYPES.has(type_id):
		pass
	else:
		# 躯干（粗细随兵种变化：这是远距离最可靠的第一眼线索）
		var body := _mesh("Body", CapsuleMesh.new(), base)
		var body_mesh: CapsuleMesh = body.mesh
		body_mesh.radius = float(build_style["body_radius"])
		body_mesh.height = float(build_style["body_height"])
		body.position = Vector3(0.0, 0.90, 0.0)
		humanoid.add_child(body)

		## 头 / 鼻尖（2026-09-25 第二轮）：`HEADLESS_TYPES` 的两个新兵种**跳过这两件**，由模型自己接管
		## （腐化师的兜帽、手雷王的面具）—— 理由与代价见 `HEADLESS_TYPES` 段的说明。
		## ⚠️ 躯干**仍在上面照建**：它是队伍色的载体，也是 `unit3d.gd` 受击闪白要找的 `Body`。
		if not HEADLESS_TYPES.has(type_id):
			# 头
			var head := _mesh("Head", SphereMesh.new(), skin)
			var head_mesh: SphereMesh = head.mesh
			head_mesh.radius = float(build_style["head_radius"])
			head_mesh.height = float(build_style["head_radius"]) * 2.0
			head.position = Vector3(0.0, 1.62, 0.0)
			humanoid.add_child(head)

			# 朝向标记（鼻尖朝 -Z，提示"正面"）
			## ⚠️ **2026-11-03 两处全局修正**（用户："把剑盾兵的鼻子变到和皮肤相同的颜色" →
			## 顺带把同一口径推给所有兵种，因为出厂那条 0.12 × 0.12 × 0.22 的**红方块**
			## 在**每个**兵种脸上都是一块凸出 10 cm 的砖）：
			##   ① 底色 `base` → **`skin`**；
			##   ② 形状 方块 → **小球**（r 0.038，扁一点），贴着**头球实测半径**放，凸出量 1.4 cm
			##      （判据与剑盾兵那颗 r 0.035 的鼻尖同一档）。
			## 它仍不是队伍色锚点（肤色两队一致），所以不带 `TeamAccent` 前缀、不写 `accent_tint`。
			var nose := _mesh("Nose", SphereMesh.new(), skin)
			var nose_mesh: SphereMesh = nose.mesh
			nose_mesh.radius = 0.038
			nose_mesh.height = 0.076
			nose_mesh.radial_segments = 10
			nose_mesh.rings = 6
			nose.scale = Vector3(0.75, 1.0, 1.05)
			nose.position = Vector3(0.0, 1.610,
					-(float(build_style["head_radius"]) - 0.026))
			humanoid.add_child(nose)

		# 通道 ② 头盔。⚠️ 传的是 `humanoid`：`_headgear()` 的形参名叫 `visual`，
		# 但它的语义就是"头盔挂到哪个父节点" —— 骑乘时那个父节点是 `Rider`。
		_headgear(type_id, humanoid, metal, cloth)
		## 通用五官（2026-11-03）：还没做精修的兵种，在这里补一对**眼球**。
		## 已经自带五官的（剑盾兵 / 长矛兵 / 短弓手 / 骑士）跳过 —— 它们各自在精修函数里按
		## 自己的护鼻 / 目镜板定位，再补一对就是四只眼。
		if not HEADLESS_TYPES.has(type_id) and not FACE_REFINED_TYPES.has(type_id):
			_add_humanoid_eyes(humanoid, metal)

	var weapon: Node3D = null
	var shield: Node3D = null

	match type_id:
		"sword", "knight":
			## 骑士（2026-09-18）与剑盾兵**共用**这一支：定位就是"数值更高的剑盾兵"，
			## 外形差异交给 ① 体型（更宽）与 ② 头盔（大盔 + 盔缨）——这正是本文件的设计原则。
			# 护肩：把上半身撑宽，与长矛兵 / 短弓手的窄肩形成对比（通道 ① 的补充）
			for side in ["left", "right"]:
				var pad := _mesh("ShoulderPad_%s" % side, BoxMesh.new(), metal)
				(pad.mesh as BoxMesh).size = Vector3(0.20, 0.17, 0.34)
				pad.position = Vector3(-0.31 if side == "left" else 0.31, 1.33, 0.0)
				visual.add_child(pad)
			# 右手：单手剑。**剑尖朝上**（2026-09-18 用户要求）——竖直持握，
			# 攻击时 `unit3d.gd#_animate_attack` 沿 X 轴压 −1.44 rad，剑自然由上向下劈到身前，
			# 正好是一记过顶劈砍；不需要另写动画分支。
			weapon = Node3D.new()
			weapon.name = "Sword"
			var blade := _mesh("Blade", BoxMesh.new(), metal)
			(blade.mesh as BoxMesh).size = Vector3(0.07, 0.07, 0.95)
			blade.position = Vector3(0.0, 0.0, -0.48)      ## 局部 −Z 是剑尖方向
			weapon.add_child(blade)
			var hilt := _mesh("Hilt", BoxMesh.new(), wood)
			(hilt.mesh as BoxMesh).size = Vector3(0.20, 0.06, 0.08)
			weapon.add_child(hilt)
			## ⚠️ 2026-11-02：骑士的躯干比剑盾兵宽（0.34 对 0.29）⇒ 握点跟着外移 0.06，
			## 否则握持手（掌半径 0.075）会有一半埋进肚子里。
			## ⚠️ **2026-11-03**：这一格只是**出厂默认**（骑士用）；剑盾兵的握点在
			## `_refine_sword_weapon()` 里被改写（让开护肩 + 抬高到剑柄上），刃口朝向在 `_sword_blade_mesh()`
			## 的截面上（宽轴 Y）；旋转两边**同一个值** `(π/2, 0, 0)`，谁也不单独滚转。
			weapon.position = Vector3(0.42, 1.05, -0.10)
			weapon.rotation = Vector3(PI * 0.5, 0.0, 0.0)  ## 局部 −Z 转到 +Y：剑尖朝上
			visual.add_child(weapon)
			# 左手：盾。⚠️ **薄轴必须是 Z**——原先写成 (0.10, 0.78, 0.58)，薄轴落在 X 上，
			# 盾面于是朝左右而不是朝前，正面看只剩一条边。2026-09-18 修（任务"平时盾牌在前方"）。
			var shield_pivot := Node3D.new()
			shield_pivot.name = "ShieldPivot"
			## 2026-09-24 用户："剑盾兵和骑士的盾往右往后移一点" ⇒ 更贴近身体（x −0.44→−0.34、z −0.58→−0.46）
			shield_pivot.position = Vector3(-0.34, 0.95, -0.46)
			# 盾面用**大幅提亮**的队伍色：和躯干同色系会糊在一起，"盾在不在身前"就读不出来了
			var shield_mesh := _mesh("ShieldPlate", BoxMesh.new(), base.lightened(0.55))
			if type_id == "knight":
				## 骑士（2026-09-24 R2 用户要求）：**塔盾 → 筝形盾（kite shield）**，三条口径全在这里：
				##   ① **上大下小**：**顶边齐平**、底边向中间收成尖；7 条竖板里**中间那片最长**
				##      ⇒ 轮廓是"肩部最宽（≈0.62 m）→ 下端收到一点"；
				##   ② **有弧度**：7 条板沿一段半径 `KITE_ARC_RADIUS` 的浅弧排开，每片绕 Y 各自转
				##      ±27°、**中间那片最靠前** ⇒ 盾面朝 −Z **前凸**（不是平板，也不是压扁的圆柱）；
				##   ③ **竖着拿**：长轴沿本体 Y、盾面朝 −Z，挂在左手侧（x = −0.44），
				##      顶边 ≈1.35 m、底尖 ≈0.40 m（≈0.95 m 高）——能盖住躯干。
				##      ⚠️ 2026-09-24 用户："筝形盾整体太小，看起来无法起到保护作用" ⇒
				##      弧半径 0.45 → **0.62**、高度 ×1.35（旧版约 0.4 × 0.7 m，是块小盾）。
				## ⚠️ 判定没动：`04_physics.md#7.1` 的格挡只看 `blocks_from()` 的角度，与盾的网格无关。
				shield_mesh = null
				## 2026-09-24 用户："塔盾的阶梯感可以消掉" ⇒ 不再是 7 条折线板，改成**一张连续曲面**
				## （`_kite_face_mesh()`）：上宽下尖的筝形 + 沿 `KITE_ARC_RADIUS` 的前凸弧一次成形，
				## 表面没有分段台阶。⚠️ 判定没动：格挡只看 `blocks_from()` 的角度。
				shield_pivot.add_child(_mesh("ShieldKite", _kite_face_mesh(),
						metal.lerp(base, 0.30).lightened(0.22)))
				# 盾缘包边：**顶边**一道金属细箍，把"盾"从"色块"里拉出来
				var rim := _mesh("ShieldRim", BoxMesh.new(), metal)
				(rim.mesh as BoxMesh).size = Vector3(0.66, 0.055, 0.07)
				rim.position = Vector3(0.0, KITE_TOP + 0.02, -0.045)
				shield_pivot.add_child(rim)
			else:
				(shield_mesh.mesh as BoxMesh).size = Vector3(0.58, 0.80, 0.10)
			if shield_mesh != null:
				shield_pivot.add_child(shield_mesh)
			var boss := _mesh("ShieldBoss", SphereMesh.new(), metal)
			(boss.mesh as SphereMesh).radius = 0.11
			(boss.mesh as SphereMesh).height = 0.22
			boss.position = Vector3(0.0, 0.12, -0.10)
			shield_pivot.add_child(boss)
			visual.add_child(shield_pivot)
			shield = shield_pivot
			if type_id == "knight":
				## 骑士的手臂（2026-11-02，参照剑盾兵那套）：动作同款，但躯干宽 0.05 ⇒ **肩 / 肘 / 握点各外移一档**，
				## 否则手会陷进肚子（判据见 `_add_arms()`）。左手仍落在盾枢轴后方。
				## ⚠️ **2026-11-03**：右手握点跟着 `KNIGHT_GRIP` 挪到 z **−0.32**（让开护肩球壳，
				## 见 `KNIGHT_GRIP` 的说明），肘同步往前折到 z −0.16 —— 前臂 ≈0.21 m，
				## 与剑盾兵的 0.23 m 同一档，不会被拉成面条（上限 `UNIT_ARM_REACH_MAX` 0.62）。
				_add_arms(humanoid, [
					["right", Vector3(0.32, 1.37, -0.02), Vector3(0.46, 1.18, -0.16),
							Vector3(0.42, 1.05, -0.32)],
					["left", Vector3(-0.32, 1.37, -0.02), Vector3(-0.46, 1.19, -0.16),
							Vector3(-0.34, 0.96, -0.38)],
				], base, skin, wood.darkened(0.36), weapon)
			if type_id == "sword":
				_add_saint_look(visual, weapon)
				_refine_sword_model(visual, weapon, shield_pivot, base, metal, wood, skin)
			elif type_id == "knight":
				## 2026-11-03：骑士按剑盾兵的建模标准重做（甲片分层 / 队伍色锚点 / 大剑 / 目缝）。
				## ⚠️ 必须排在 `_add_arms()` **之后**：护腕要挂到前臂节点下、拳心要改到剑柄上。
				_refine_knight_model(visual, weapon, shield_pivot, base, metal, wood)
		"spear":
			# 双手长矛，长度视觉上对得上 3m 射程。
			# ⚠️ **平直持握**（2026-09-18 用户要求）：矛杆水平指向前方（本体的 −Z），
			# 不抬手、不斜举——所以矛尖不再高过头顶，"比人高"这条旧描述作废。
			# 攻击动作也不是挥砍，而是**沿矛杆方向前后突刺**（见 `unit3d.gd#_animate_attack`）。
			weapon = Node3D.new()
			weapon.name = "Spear"
