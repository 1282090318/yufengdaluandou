			## 这是"数值更高"在轮廓上的表达（通道 ②）。
			var great := _mesh("GreatHelm", CylinderMesh.new(), metal)
			var great_mesh: CylinderMesh = great.mesh
			great_mesh.top_radius = 0.20
			great_mesh.bottom_radius = 0.255
			great_mesh.height = 0.52
			great_mesh.radial_segments = 10
