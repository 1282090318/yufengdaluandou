				lid_mesh.outer_radius = cross - 0.02 + lid_tube * 2.0
				lid_mesh.rings = 48
				lid_mesh.ring_segments = 12
				## 环面默认躺在 XZ 平面（绕 Y 轴一圈）= 天然的"上下眼睑那两圈" ⇒ 只需按开合方向倾一下
				lid.rotate_object_local(Vector3.RIGHT, -lid_sign * DOOM_LID_PITCH)
