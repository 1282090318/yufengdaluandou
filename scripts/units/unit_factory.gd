## 月牙盾：一段缺口朝向身体（+X）的弧带。外弧鼓向左外侧，读起来是弯月而不是圆盾。
## 双面都画，调用方关掉背面剔除。
static func _crescent_shield_mesh() -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var outer_r := 0.38
	var inner_r := 0.16
	var arc_from := 0.95
	var arc_to := TAU - 0.95
	var steps := 16
	for i in steps:
		var t0 := float(i) / float(steps)
		var t1 := float(i + 1) / float(steps)
		var a0 := lerpf(arc_from, arc_to, t0)
		var a1 := lerpf(arc_from, arc_to, t1)
		var outer0 := Vector3(cos(a0) * outer_r, sin(a0) * outer_r, 0.0)
		var outer1 := Vector3(cos(a1) * outer_r, sin(a1) * outer_r, 0.0)
		var inner0 := Vector3(cos(a0) * inner_r, sin(a0) * inner_r, 0.0)
		var inner1 := Vector3(cos(a1) * inner_r, sin(a1) * inner_r, 0.0)
		st.set_normal(Vector3(0.0, 0.0, -1.0))
		st.add_vertex(outer0)
		st.add_vertex(inner0)
		st.add_vertex(outer1)
		st.set_normal(Vector3(0.0, 0.0, -1.0))
		st.add_vertex(outer1)
		st.add_vertex(inner0)
		st.add_vertex(inner1)
		st.set_normal(Vector3(0.0, 0.0, 1.0))
		st.add_vertex(outer0)
		st.add_vertex(outer1)
		st.add_vertex(inner0)
		st.set_normal(Vector3(0.0, 0.0, 1.0))
		st.add_vertex(outer1)
		st.add_vertex(inner1)
		st.add_vertex(inner0)
	return st.commit()

