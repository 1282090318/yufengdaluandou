			_refine_doom_eye_model(visual, weapon)
			var gather := Node3D.new()
			gather.name = "ChargeGather"
			gather.visible = false
			gather.add_child(_soft_ball("ChargeCore", 0.14, DOOM_GLOW_COLOR))
			for mote_i in 8:
