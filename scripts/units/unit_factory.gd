			var pupil := _mesh("Pupil", SphereMesh.new(), DOOM_PUPIL_COLOR)
			var pupil_mesh: SphereMesh = pupil.mesh
			pupil_mesh.radius = DOOM_PUPIL_R
			pupil_mesh.height = DOOM_PUPIL_R * 2.0
			pupil_mesh.radial_segments = 20
			pupil_mesh.rings = 10
